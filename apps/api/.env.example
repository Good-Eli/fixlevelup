# Supply these values explicitly; entrypoints do not load .env files.
NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=4000
SHUTDOWN_TIMEOUT_MS=10000
# Required for API and worker. Supply the existing runtime-role password separately.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=fixlevelup_dev
DB_USER=fixlevelup_runtime
DB_PASSWORD=
# Web authentication is disabled unless explicitly enabled. Never commit secrets.
WEB_AUTH_ENABLED=0
# For WEB_AUTH_ENABLED=1, set a canonical HTTPS origin and two independent
# cryptographically random 32-byte secrets encoded as 64 lowercase hex characters.
# WEB_AUTH_ORIGIN=
# WEB_AUTH_CSRF_SECRET=
# WEB_AUTH_THROTTLE_SECRET=
# Telegram Mini App staff authentication is disabled unless explicitly enabled.
# Requires WEB_AUTH_ENABLED=1; the bot token comes only from the environment.
# TELEGRAM_AUTH_ENABLED=0
# TELEGRAM_BOT_TOKEN=
