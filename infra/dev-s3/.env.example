# Generate locally with: node packages/storage-tooling/scripts/init.mjs
# Local .env is ignored by Git; never paste real keys into this example.
GARAGE_RPC_SECRET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_READONLY_ACCESS_KEY_ID=
S3_READONLY_SECRET_ACCESS_KEY=
