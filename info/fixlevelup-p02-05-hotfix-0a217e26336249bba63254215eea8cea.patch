diff --git a/apps/api/src/auth/telegram-initdata.ts b/apps/api/src/auth/telegram-initdata.ts
new file mode 100644
index 0000000..9c97bd8
--- /dev/null
+++ b/apps/api/src/auth/telegram-initdata.ts
@@ -0,0 +1,132 @@
+import { createHash, createHmac, timingSafeEqual } from 'node:crypto';
+
+/** Raw Telegram Mini App initData verification (P02-05), node:crypto only.
+ * The structure is cross-checked against the official Mini Apps documentation example
+ * (public sample bot token/hash published by Telegram for this exact algorithm, see
+ * the pinned test vector in telegram-initdata.test.ts):
+ * data-check-string = every parameter except `hash`, sorted alphabetically, as
+ * decoded `key=value` lines joined with `\n`;
+ * secret = HMAC_SHA256 with key 'WebAppData' over the bot token (raw bytes);
+ * expected = HMAC_SHA256(secret, data-check-string) as lowercase hex;
+ * timing-safe comparison with the `hash` parameter.
+ * The Ed25519 third-party-signature path is intentionally not implemented; a
+ * `signature` parameter, when present, only participates in the data-check-string.
+ * `initDataUnsafe` is never trusted; only this verified raw form is.
+ */
+
+export type TelegramInitDataErrorCode = 'INVALID_INPUT' | 'INVALID_SIGNATURE' | 'EXPIRED' | 'FUTURE_DATE';
+
+export class TelegramInitDataError extends Error {
+  constructor(readonly code: TelegramInitDataErrorCode) {
+    super('Telegram init data verification failed');
+    this.name = 'TelegramInitDataError';
+  }
+}
+
+export interface TelegramInitDataVerifyOptions {
+  /** Deterministic clock injection for tests; defaults to the wall clock. */
+  readonly now?: Date;
+  /** Owner-approved exchange freshness window: 24 hours after auth_date. */
+  readonly maxAgeSeconds?: number;
+  /** Owner-approved future skew tolerance: 60 seconds. */
+  readonly futureSkewSeconds?: number;
+}
+
+export interface VerifiedInitData {
+  /** Telegram user id as a decimal string; never a JavaScript number (BIGINT-safe). */
+  readonly telegramUserId: string;
+  readonly authDate: Date;
+  /** sha256(data-check-string) hex: the replay digest stored with the session. */
+  readonly digest: string;
+}
+
+/** Reordered raw initData strings produce the same canonical digest; the same
+ * data-check-string always yields one stable digest value.
+ */
+export const MAX_INIT_DATA_CHARS = 4096;
+
+const MAX_PARAMETERS = 32;
+const MAX_KEY_CHARS = 64;
+const MAX_VALUE_CHARS = 2048;
+const HASH_PATTERN = /^[0-9a-f]{64}$/;
+const AUTH_DATE_PATTERN = /^(0|[1-9][0-9]{0,9})$/;
+const DEFAULT_MAX_AGE_SECONDS = 86400;
+const DEFAULT_FUTURE_SKEW_SECONDS = 60;
+
+interface Parameter { readonly key: string; readonly value: string }
+
+function decode(value: string): string {
+  try { return decodeURIComponent(value); }
+  catch { throw new TelegramInitDataError('INVALID_INPUT'); }
+}
+
+/** Manual x-www-form-adjacent parsing: Telegram percent-encodes initData values
+ * (encodeURIComponent style), and duplicate keys are a forgery, so silently
+ * collapsing them like URLSearchParams would is rejected instead.
+ */
+function parseParameters(rawInitData: string): Parameter[] {
+  const parameters: Parameter[] = [];
+  const seen = new Set<string>();
+  for (const part of rawInitData.split('&')) {
+    const separator = part.indexOf('=');
+    if (separator < 1) { throw new TelegramInitDataError('INVALID_INPUT'); }
+    const key = decode(part.slice(0, separator));
+    const value = decode(part.slice(separator + 1));
+    if (key.length < 1 || key.length > MAX_KEY_CHARS || value.length > MAX_VALUE_CHARS) {
+      throw new TelegramInitDataError('INVALID_INPUT');
+    }
+    if (seen.has(key)) { throw new TelegramInitDataError('INVALID_INPUT'); }
+    seen.add(key);
+    parameters.push({ key, value });
+  }
+  if (parameters.length > MAX_PARAMETERS) { throw new TelegramInitDataError('INVALID_INPUT'); }
+  return parameters;
+}
+
+export function verifyInitData(
+  rawInitData: string,
+  botToken: string,
+  options?: TelegramInitDataVerifyOptions,
+): VerifiedInitData {
+  if (typeof rawInitData !== 'string' || rawInitData.length < 1 || rawInitData.length > MAX_INIT_DATA_CHARS
+    || typeof botToken !== 'string' || botToken.length < 1) { throw new TelegramInitDataError('INVALID_INPUT'); }
+  const parameters = parseParameters(rawInitData);
+  let hash: string | undefined;
+  for (const parameter of parameters) {
+    if (parameter.key === 'hash') { hash = parameter.value; }
+  }
+  if (hash === undefined || !HASH_PATTERN.test(hash)) { throw new TelegramInitDataError('INVALID_INPUT'); }
+  const dataCheckString = parameters.filter((parameter) => parameter.key !== 'hash')
+    .sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : 0))
+    .map((parameter) => `${parameter.key}=${parameter.value}`)
+    .join('\n');
+  const secret = createHmac('sha256', 'WebAppData').update(botToken).digest();
+  const expected = createHmac('sha256', secret).update(dataCheckString).digest('hex');
+  const supplied = Buffer.from(hash, 'utf8');
+  const computed = Buffer.from(expected, 'utf8');
+  if (supplied.length !== computed.length || !timingSafeEqual(supplied, computed)) {
+    throw new TelegramInitDataError('INVALID_SIGNATURE');
+  }
+  const authDateText = parameters.find((parameter) => parameter.key === 'auth_date')?.value;
+  if (authDateText === undefined || !AUTH_DATE_PATTERN.test(authDateText)) { throw new TelegramInitDataError('INVALID_INPUT'); }
+  const authDateSeconds = Number(authDateText);
+  const authDateMs = authDateSeconds * 1000;
+  const nowMs = (options?.now ?? new Date()).getTime();
+  const maxAgeSeconds = options?.maxAgeSeconds ?? DEFAULT_MAX_AGE_SECONDS;
+  const futureSkewSeconds = options?.futureSkewSeconds ?? DEFAULT_FUTURE_SKEW_SECONDS;
+  if (nowMs - authDateMs > maxAgeSeconds * 1000) { throw new TelegramInitDataError('EXPIRED'); }
+  if (authDateMs - nowMs > futureSkewSeconds * 1000) { throw new TelegramInitDataError('FUTURE_DATE'); }
+  const userText = parameters.find((parameter) => parameter.key === 'user')?.value;
+  if (userText === undefined) { throw new TelegramInitDataError('INVALID_INPUT'); }
+  let user: unknown;
+  try { user = JSON.parse(userText); }
+  catch { throw new TelegramInitDataError('INVALID_INPUT'); }
+  if (user === null || typeof user !== 'object' || Array.isArray(user)) { throw new TelegramInitDataError('INVALID_INPUT'); }
+  const id = (user as Record<string, unknown>)['id'];
+  if (typeof id !== 'number' || !Number.isSafeInteger(id) || id <= 0) { throw new TelegramInitDataError('INVALID_INPUT'); }
+  return {
+    telegramUserId: String(id),
+    authDate: new Date(authDateMs),
+    digest: createHash('sha256').update(dataCheckString).digest('hex'),
+  };
+}
diff --git a/apps/api/src/auth/telegram-auth.config.ts b/apps/api/src/auth/telegram-auth.config.ts
new file mode 100644
index 0000000..c067157
--- /dev/null
+++ b/apps/api/src/auth/telegram-auth.config.ts
@@ -0,0 +1,25 @@
+import { ConfigurationError } from '../runtime/config.js';
+
+/** Telegram Mini App staff authentication is absent unless explicitly enabled.
+ * Partial or unsafe configuration fails closed, mirroring web auth config.
+ * The bot token comes only from the environment, is never logged and is not
+ * committed; missing/invalid secrets close the real connection but do not
+ * block offline fixtures (DECISIONS §21).
+ */
+export interface TelegramAuthConfig {
+  readonly botToken: string;
+}
+
+export function loadTelegramAuthConfig(env: NodeJS.ProcessEnv): TelegramAuthConfig | undefined {
+  const enabled = env['TELEGRAM_AUTH_ENABLED'];
+  if (enabled === undefined || enabled === '0') {
+    if (env['TELEGRAM_BOT_TOKEN']) { throw new ConfigurationError(['TELEGRAM_AUTH_ENABLED']); }
+    return undefined;
+  }
+  const fields: string[] = [];
+  if (enabled !== '1') { fields.push('TELEGRAM_AUTH_ENABLED'); }
+  const botToken = env['TELEGRAM_BOT_TOKEN'] ?? '';
+  if (!/^[0-9]+:[A-Za-z0-9_-]{30,}$/.test(botToken)) { fields.push('TELEGRAM_BOT_TOKEN'); }
+  if (fields.length) { throw new ConfigurationError(fields); }
+  return Object.freeze({ botToken });
+}
diff --git a/apps/api/src/auth/telegram-auth.service.ts b/apps/api/src/auth/telegram-auth.service.ts
new file mode 100644
index 0000000..96f7e13
--- /dev/null
+++ b/apps/api/src/auth/telegram-auth.service.ts
@@ -0,0 +1,281 @@
+import { createHash, createHmac, randomBytes, randomUUID } from 'node:crypto';
+import type { Pool, PoolClient } from 'pg';
+import { MAX_INIT_DATA_CHARS, verifyInitData } from './telegram-initdata.js';
+import { TelegramInitDataError } from './telegram-initdata.js';
+import type { VerifiedInitData } from './telegram-initdata.js';
+
+/** Staff Telegram Mini App authentication (P02-05) over foundation.web_sessions
+ * rows with channel 'STAFF_TELEGRAM' (migration 20261120000700) and
+ * foundation.staff_telegram_links. Owner-approved policy (DECISIONS §21):
+ * TECHNICIAN-only, 2h idle / 24h absolute TTL, single initData exchange with a
+ * 60-second grace window; within grace a repeat returns the same session with a
+ * rotated token, after grace (or after revocation) the digest is denied.
+ * Concurrency: pg_advisory_xact_lock over the initData digest serializes
+ * simultaneous exchanges of the same initData; the staff row is locked before
+ * the session row, matching the P02-03 lock order.
+ */
+export type TelegramAuthErrorCode = 'UNAUTHORIZED' | 'REPLAY' | 'RATE_LIMITED' | 'INVALID_INPUT' | 'FAILED';
+
+export class TelegramAuthError extends Error {
+  constructor(readonly code: TelegramAuthErrorCode) {
+    super('Telegram staff authentication failed');
+    this.name = 'TelegramAuthError';
+  }
+}
+
+export interface TelegramSessionIdentity {
+  readonly staffId: string;
+  readonly role: 'TECHNICIAN';
+  readonly authVersion: number;
+  /** Decimal string of the Telegram user id (BIGINT end to end). */
+  readonly telegramUserId: string;
+  readonly idleExpiresAt: Date;
+  readonly absoluteExpiresAt: Date;
+}
+
+export interface TelegramSessionCredential extends TelegramSessionIdentity { readonly token: string }
+
+export interface TelegramAuthOptions {
+  readonly botToken: string;
+  /** Reuses WEB_AUTH_THROTTLE_SECRET (owner decision); separate dimensions keep
+   * telegram-user and source buckets independent of web login buckets.
+   */
+  readonly throttleSecret: string | Buffer;
+  readonly sourceLimit?: number;
+}
+
+interface StaffRow { id: string; role: 'TECHNICIAN'; auth_version: number }
+interface SessionRow { id: string; staff_id: string; auth_version: number; idle_expires_at: Date; absolute_expires_at: Date }
+interface PriorRow { id: string; staff_id: string; telegram_link_id: string; revoked_at: Date | null }
+interface LinkRow { id: string; staff_id: string; telegram_user_id: string }
+
+const TOKEN = /^[A-Za-z0-9_-]{43}$/;
+const BOT_TOKEN = /^[0-9]+:[A-Za-z0-9_-]{30,}$/;
+const TELEGRAM_USER_ATTEMPT_LIMIT = 5;
+const DEFAULT_SOURCE_LIMIT = 50;
+const hashToken = (token: string): string => createHash('sha256').update(token).digest('hex');
+const newToken = (): string => randomBytes(32).toString('base64url');
+interface Reservation { key: string; id: string }
+type ExchangeOutcome = { ok: true; credential: TelegramSessionCredential } | { ok: false; code: TelegramAuthErrorCode };
+
+/** Core only: callers must provide a trusted socket-derived source, never a forwarded header. */
+export class TelegramAuthService {
+  private readonly secret: Buffer;
+  private readonly sourceLimit: number;
+  private readonly botToken: string;
+
+  constructor(private readonly pool: Pick<Pool, 'connect'>, options: TelegramAuthOptions) {
+    this.secret = Buffer.from(options.throttleSecret);
+    this.sourceLimit = options.sourceLimit ?? DEFAULT_SOURCE_LIMIT;
+    this.botToken = options.botToken;
+    if (!BOT_TOKEN.test(this.botToken) || this.secret.length < 32
+      || !Number.isInteger(this.sourceLimit) || this.sourceLimit < 5 || this.sourceLimit > 10000) {
+      throw new TelegramAuthError('FAILED');
+    }
+  }
+
+  private key(dimension: string, value: string): string {
+    return createHmac('sha256', this.secret).update(dimension).update('\0').update(value).digest('hex');
+  }
+
+  private async transaction<T>(fn: (client: PoolClient) => Promise<T>): Promise<T> {
+    let client: PoolClient | undefined;
+    let inTransaction = false;
+    let discard = false;
+    try {
+      client = await this.pool.connect();
+      await client.query('BEGIN');
+      inTransaction = true;
+      const result = await fn(client);
+      await client.query('COMMIT');
+      inTransaction = false;
+      return result;
+    } catch (error) {
+      if (client && inTransaction) { try { await client.query('ROLLBACK'); } catch { discard = true; } }
+      if (error instanceof TelegramAuthError) { throw error; }
+      throw new TelegramAuthError('FAILED');
+    } finally { client?.release(discard); }
+  }
+
+  /** Each in-flight exchange attempt consumes a slot. Crashes fail closed until
+   * the 15-minute expiry. Reuses the web auth throttle tables with dedicated
+   * HMAC dimensions ('telegram-user' 5/15m, 'source' 50/15m, owner decision).
+   */
+  private async reserve(telegramUserId: string, source: string): Promise<readonly Reservation[]> {
+    const entries = [
+      { key: this.key('telegram-user', telegramUserId), limit: TELEGRAM_USER_ATTEMPT_LIMIT },
+      { key: this.key('source', source), limit: this.sourceLimit },
+    ].sort((a, b) => a.key.localeCompare(b.key));
+    return this.transaction(async (client) => {
+      const reservations: Reservation[] = [];
+      for (const entry of entries) {
+        await client.query('INSERT INTO foundation.web_auth_throttles (key_hash) VALUES ($1) ON CONFLICT (key_hash) DO NOTHING', [entry.key]);
+        const lock = await client.query('SELECT key_hash FROM foundation.web_auth_throttles WHERE key_hash = $1 FOR UPDATE', [entry.key]);
+        if (lock.rowCount !== 1) { throw new TelegramAuthError('FAILED'); }
+        const count = await client.query<{ count: string }>(`SELECT count(*) AS count FROM foundation.web_auth_attempts
+          WHERE key_hash = $1 AND expires_at > clock_timestamp() AND (completed_at IS NULL OR failed_at IS NOT NULL)`, [entry.key]);
+        if (Number(count.rows[0]?.count ?? entry.limit) >= entry.limit) { throw new TelegramAuthError('RATE_LIMITED'); }
+        const id = randomUUID();
+        await client.query(`INSERT INTO foundation.web_auth_attempts (id, key_hash, reserved_at, expires_at)
+          VALUES ($1, $2, clock_timestamp(), clock_timestamp() + interval '15 minutes')`, [id, entry.key]);
+        reservations.push({ id, key: entry.key });
+      }
+      return reservations;
+    });
+  }
+
+  private async finish(client: PoolClient, reservations: readonly Reservation[], failed: boolean): Promise<void> {
+    for (const reservation of reservations) {
+      const locked = await client.query('SELECT key_hash FROM foundation.web_auth_throttles WHERE key_hash = $1 FOR UPDATE', [reservation.key]);
+      if (locked.rowCount !== 1) { throw new TelegramAuthError('FAILED'); }
+      const result = await client.query(`WITH stamp AS MATERIALIZED (SELECT clock_timestamp() AS now)
+        UPDATE foundation.web_auth_attempts SET completed_at = stamp.now, failed_at = CASE WHEN $3 THEN stamp.now ELSE NULL END,
+            expires_at = CASE WHEN $3 THEN stamp.now + interval '15 minutes' ELSE expires_at END
+        FROM stamp WHERE id = $1 AND key_hash = $2 AND completed_at IS NULL AND expires_at > stamp.now`,
+      [reservation.id, reservation.key, failed]);
+      if (result.rowCount !== 1) { throw new TelegramAuthError('FAILED'); }
+    }
+  }
+
+  private async lockedStaff(client: PoolClient, staffId: string): Promise<StaffRow | undefined> {
+    const result = await client.query<StaffRow>(
+      `SELECT s.id, s.role, s.auth_version FROM foundation.staff s
+       WHERE s.id = $1 AND s.employment_state = 'ACTIVE' AND s.role = 'TECHNICIAN' FOR UPDATE`, [staffId]);
+    return result.rows[0];
+  }
+
+  async exchange(rawInitData: string, source: string): Promise<TelegramSessionCredential> {
+    if (typeof rawInitData !== 'string' || rawInitData.length < 1 || rawInitData.length > MAX_INIT_DATA_CHARS
+      || typeof source !== 'string' || source.length < 1 || source.length > 256) { throw new TelegramAuthError('INVALID_INPUT'); }
+    let verified: VerifiedInitData;
+    try { verified = verifyInitData(rawInitData, this.botToken); }
+    catch (error) {
+      if (error instanceof TelegramInitDataError) {
+        throw new TelegramAuthError(error.code === 'INVALID_INPUT' ? 'INVALID_INPUT' : 'UNAUTHORIZED');
+      }
+      throw error;
+    }
+    // Verified signature first (no DB access), so only verified identities occupy throttle buckets.
+    const reservations = await this.reserve(verified.telegramUserId, source);
+    const token = newToken();
+    const outcome = await this.transaction(async (client): Promise<ExchangeOutcome> => {
+      // Serialize simultaneous exchanges of the same initData across all instances.
+      await client.query('SELECT pg_advisory_xact_lock(hashtextextended($1, 0))', [verified.digest]);
+      const prior = await client.query<PriorRow>(
+        `SELECT ws.id, ws.staff_id, ws.telegram_link_id, ws.revoked_at FROM foundation.web_sessions ws
+         WHERE ws.initdata_digest = $1 AND ws.channel = 'STAFF_TELEGRAM'
+         ORDER BY ws.created_at DESC LIMIT 1`, [verified.digest]);
+      const priorRow = prior.rows[0];
+      if (priorRow) {
+        if (priorRow.revoked_at !== null) { await this.finish(client, reservations, true); return { ok: false, code: 'REPLAY' }; }
+        const staff = await this.lockedStaff(client, priorRow.staff_id);
+        if (!staff) { await this.finish(client, reservations, true); return { ok: false, code: 'UNAUTHORIZED' }; }
+        // The exact link used at the original exchange must still be active and bound to
+        // the same Telegram identity: a re-bind (revoke A + link B) must not resurrect
+        // an old session through the grace window.
+        const priorLink = await client.query(
+          `SELECT 1 FROM foundation.staff_telegram_links l
+           WHERE l.id = $1 AND l.staff_id = $2 AND l.telegram_user_id = $3::bigint AND l.revoked_at IS NULL
+           FOR UPDATE OF l`, [priorRow.telegram_link_id, priorRow.staff_id, verified.telegramUserId]);
+        if (priorLink.rowCount !== 1) { await this.finish(client, reservations, true); return { ok: false, code: 'UNAUTHORIZED' }; }
+        // Grace window: same session, rotated token, idle refreshed, absolute TTL unchanged.
+        const rotated = await client.query<SessionRow>(
+          `UPDATE foundation.web_sessions SET token_hash = $1,
+             idle_expires_at = LEAST(absolute_expires_at, clock_timestamp() + interval '2 hours')
+           WHERE id = $2 AND initdata_digest = $3 AND channel = 'STAFF_TELEGRAM' AND revoked_at IS NULL
+             AND initdata_exchanged_at + interval '60 seconds' >= clock_timestamp()
+           RETURNING id, staff_id, auth_version, idle_expires_at, absolute_expires_at`,
+          [hashToken(token), priorRow.id, verified.digest]);
+        const row = rotated.rows[0];
+        if (!row) { await this.finish(client, reservations, true); return { ok: false, code: 'REPLAY' }; }
+        await this.finish(client, reservations, false);
+        return {
+          ok: true,
+          credential: {
+            staffId: row.staff_id, role: staff.role, authVersion: row.auth_version,
+            telegramUserId: verified.telegramUserId, idleExpiresAt: row.idle_expires_at,
+            absoluteExpiresAt: row.absolute_expires_at, token,
+          },
+        };
+      }
+      // New exchange: only a pre-existing active staff Telegram link authorizes a session;
+      // unknown Telegram users are never registered automatically. The link row is
+      // locked (after staff) so a concurrent revoke of this exact link serializes
+      // against the exchange; the link id is pinned immutably into the session.
+      const link = await client.query<LinkRow>(
+        `SELECT l.id, l.staff_id, l.telegram_user_id::text AS telegram_user_id
+         FROM foundation.staff_telegram_links l
+         WHERE l.telegram_user_id = $1::bigint AND l.revoked_at IS NULL`,
+        [verified.telegramUserId]);
+      const linked = link.rows[0];
+      if (!linked) { await this.finish(client, reservations, true); return { ok: false, code: 'UNAUTHORIZED' }; }
+      const staff = await this.lockedStaff(client, linked.staff_id);
+      if (!staff) { await this.finish(client, reservations, true); return { ok: false, code: 'UNAUTHORIZED' }; }
+      await client.query('SELECT 1 FROM foundation.staff_telegram_links WHERE id = $1 FOR UPDATE', [linked.id]);
+      const inserted = await client.query<SessionRow>(
+        `INSERT INTO foundation.web_sessions (id, staff_id, token_hash, auth_version, created_at,
+           idle_expires_at, absolute_expires_at, channel, initdata_digest, initdata_exchanged_at, telegram_link_id)
+         VALUES ($1, $2, $3, $4, clock_timestamp(), clock_timestamp() + interval '2 hours',
+           clock_timestamp() + interval '24 hours', 'STAFF_TELEGRAM', $5, clock_timestamp(), $6)
+         RETURNING id, staff_id, auth_version, idle_expires_at, absolute_expires_at`,
+        [randomUUID(), staff.id, hashToken(token), staff.auth_version, verified.digest, linked.id]);
+      const row = inserted.rows[0];
+      if (!row) { throw new TelegramAuthError('FAILED'); }
+      await this.finish(client, reservations, false);
+      return {
+        ok: true,
+        credential: {
+          staffId: row.staff_id, role: staff.role, authVersion: row.auth_version,
+          telegramUserId: verified.telegramUserId, idleExpiresAt: row.idle_expires_at,
+          absoluteExpiresAt: row.absolute_expires_at, token,
+        },
+      };
+    });
+    if (!outcome.ok) { throw new TelegramAuthError(outcome.code); }
+    return outcome.credential;
+  }
+
+  /** Bearer-style token check: the session's pinned link (same id, same staff, same
+   * Telegram identity, still active), staff state and auth_version are re-verified on
+   * every use; idle TTL slides within the unchanged absolute TTL; revoked sessions fail.
+   */
+  async authenticate(token: string): Promise<TelegramSessionIdentity> {
+    if (typeof token !== 'string' || !TOKEN.test(token)) { throw new TelegramAuthError('UNAUTHORIZED'); }
+    const digest = hashToken(token);
+    return this.transaction(async (client) => {
+      const candidate = await client.query<{ staff_id: string }>(
+        "SELECT staff_id FROM foundation.web_sessions WHERE token_hash = $1 AND channel = 'STAFF_TELEGRAM'", [digest]);
+      const staffId = candidate.rows[0]?.staff_id;
+      if (!staffId) { throw new TelegramAuthError('UNAUTHORIZED'); }
+      const staff = await client.query<{ id: string }>(
+        "SELECT id FROM foundation.staff WHERE id = $1 AND employment_state = 'ACTIVE' AND role = 'TECHNICIAN' FOR UPDATE", [staffId]);
+      if (!staff.rows[0]) { throw new TelegramAuthError('UNAUTHORIZED'); }
+      const result = await client.query<SessionRow & { telegram_user_id: string }>(
+        `SELECT ws.id, ws.staff_id, ws.auth_version, ws.idle_expires_at, ws.absolute_expires_at, l.telegram_user_id
+         FROM foundation.web_sessions ws
+         JOIN foundation.staff s ON s.id = ws.staff_id
+         JOIN foundation.staff_telegram_links l ON l.id = ws.telegram_link_id AND l.staff_id = ws.staff_id
+           AND l.telegram_user_id::text = (
+             SELECT l2.telegram_user_id::text FROM foundation.staff_telegram_links l2
+             WHERE l2.id = ws.telegram_link_id AND l2.staff_id = ws.staff_id AND l2.revoked_at IS NULL)
+         WHERE ws.token_hash = $1 AND ws.staff_id = $2 AND ws.channel = 'STAFF_TELEGRAM' AND ws.revoked_at IS NULL
+           AND ws.idle_expires_at > clock_timestamp() AND ws.absolute_expires_at > clock_timestamp()
+           AND ws.auth_version = s.auth_version AND s.employment_state = 'ACTIVE' AND s.role = 'TECHNICIAN'
+         FOR UPDATE OF ws`, [digest, staffId]);
+      const session = result.rows[0];
+      if (!session) { throw new TelegramAuthError('UNAUTHORIZED'); }
+      const updated = await client.query<SessionRow>(
+        `UPDATE foundation.web_sessions SET idle_expires_at = LEAST(absolute_expires_at, clock_timestamp() + interval '2 hours')
+         WHERE id = $1 AND token_hash = $2 AND revoked_at IS NULL
+           AND idle_expires_at > clock_timestamp() AND absolute_expires_at > clock_timestamp()
+         RETURNING id, staff_id, auth_version, idle_expires_at, absolute_expires_at`, [session.id, digest]);
+      const row = updated.rows[0];
+      if (!row) { throw new TelegramAuthError('UNAUTHORIZED'); }
+      return {
+        staffId: row.staff_id, role: 'TECHNICIAN', authVersion: row.auth_version,
+        telegramUserId: session.telegram_user_id, idleExpiresAt: row.idle_expires_at,
+        absoluteExpiresAt: row.absolute_expires_at,
+      };
+    });
+  }
+}
diff --git a/apps/api/src/auth/telegram-auth.controller.ts b/apps/api/src/auth/telegram-auth.controller.ts
new file mode 100644
index 0000000..3ac00fe
--- /dev/null
+++ b/apps/api/src/auth/telegram-auth.controller.ts
@@ -0,0 +1,70 @@
+import { randomUUID } from 'node:crypto';
+import type { IncomingMessage } from 'node:http';
+import {
+  BadRequestException, Controller, Header, HttpCode, HttpException,
+  Inject, InternalServerErrorException, Post, Req,
+} from '@nestjs/common';
+import { bodyFields } from './http.js';
+import { TelegramAuthError } from './telegram-auth.service.js';
+import type { TelegramSessionCredential, TelegramSessionIdentity } from './telegram-auth.service.js';
+
+/** Bind these explicit tokens in the consuming module; this controller registers no providers.
+ * The exchange deliberately has no Origin/CSRF requirement (owner decision): the session
+ * token is returned only in the JSON body — never a cookie — so no ambient authority
+ * is created and cross-site requests cannot authenticate anything. The token lives
+ * in Mini App memory only (DECISIONS §21). TLS, the strict JSON parser, size limits
+ * and rate limiting remain mandatory at the host.
+ */
+export const TELEGRAM_AUTH_SERVICE = Symbol('TELEGRAM_AUTH_SERVICE');
+
+export interface TelegramAuthServiceApi {
+  exchange(rawInitData: string, source: string): Promise<TelegramSessionCredential>;
+  authenticate(token: string): Promise<TelegramSessionIdentity>;
+}
+
+type Request = IncomingMessage & { body?: unknown };
+
+function field(fields: Record<string, string>, name: string): string {
+  const value = fields[name];
+  if (value === undefined) { throw new BadRequestException(); }
+  return value;
+}
+
+function mapError(error: unknown): never {
+  if (!(error instanceof TelegramAuthError)) { throw error; }
+  switch (error.code) {
+    case 'UNAUTHORIZED': case 'REPLAY': throw new BadRequestException();
+    case 'RATE_LIMITED': throw new HttpException('Too Many Requests', 429);
+    case 'INVALID_INPUT': throw new BadRequestException();
+    default: throw new InternalServerErrorException();
+  }
+}
+
+@Controller('api/v1/auth')
+export class TelegramAuthController {
+  constructor(@Inject(TELEGRAM_AUTH_SERVICE) private readonly service: TelegramAuthServiceApi) {}
+
+  /** Raw initData → opaque staff session token in the JSON body (no cookie, no CSRF). */
+  @Post('telegram-miniapp') @HttpCode(200) @Header('Cache-Control', 'no-store')
+  async exchange(@Req() req: Request) {
+    const fields = bodyFields(req.body, ['initData']);
+    const source = req.socket.remoteAddress;
+    if (!source) { throw new BadRequestException(); }
+    try {
+      const credential = await this.service.exchange(field(fields, 'initData'), source);
+      // telegramUserId stays a decimal string end to end (BIGINT, never a JS number).
+      return {
+        data: {
+          sessionToken: credential.token,
+          staffId: credential.staffId,
+          role: credential.role,
+          authVersion: credential.authVersion,
+          telegramUserId: credential.telegramUserId,
+          idleExpiresAt: credential.idleExpiresAt,
+          absoluteExpiresAt: credential.absoluteExpiresAt,
+        },
+        meta: { requestId: randomUUID() },
+      };
+    } catch (error) { return mapError(error); }
+  }
+}
diff --git a/apps/api/src/auth/telegram-auth.resources.ts b/apps/api/src/auth/telegram-auth.resources.ts
new file mode 100644
index 0000000..a30ee37
--- /dev/null
+++ b/apps/api/src/auth/telegram-auth.resources.ts
@@ -0,0 +1,27 @@
+import type { OnModuleDestroy } from '@nestjs/common';
+import { Pool } from 'pg';
+import type { DatabaseConfig } from '../infrastructure/database/runtime-database.js';
+import type { TelegramAuthConfig } from './telegram-auth.config.js';
+import { TelegramAuthService } from './telegram-auth.service.js';
+
+/** A separate bounded pool keeps Telegram auth queries isolated from other pools;
+ * raw driver errors and credentials are never logged, matching WebAuthResources.
+ * Session cleanup itself is shared: telegram sessions live in foundation.web_sessions
+ * and are removed by the existing cleanup_web_sessions() timer in WebAuthResources.
+ */
+export class TelegramAuthResources implements OnModuleDestroy {
+  private readonly pool: Pool;
+  readonly service: TelegramAuthService;
+
+  constructor(database: DatabaseConfig, config: TelegramAuthConfig, throttleSecret: string) {
+    this.pool = new Pool({ ...database, max: 4, connectionTimeoutMillis: 1000,
+      query_timeout: 5000, statement_timeout: 5000, idleTimeoutMillis: 1000,
+      application_name: 'fixlevelup-telegram-auth' });
+    this.pool.on('error', () => { /* Never log raw driver errors. */ });
+    this.service = new TelegramAuthService(this.pool, { botToken: config.botToken, throttleSecret });
+  }
+
+  async onModuleDestroy(): Promise<void> {
+    await this.pool.end();
+  }
+}
diff --git a/apps/api/tests/telegram-initdata.test.ts b/apps/api/tests/telegram-initdata.test.ts
new file mode 100644
index 0000000..24bb72c
--- /dev/null
+++ b/apps/api/tests/telegram-initdata.test.ts
@@ -0,0 +1,154 @@
+import { createHash, createHmac } from 'node:crypto';
+import { describe, expect, it } from 'vitest';
+import { TelegramInitDataError, verifyInitData } from '../src/auth/telegram-initdata.js';
+
+/** Official documentation example vector (docs.telegram-mini-apps.com/platform/init-data,
+ * mirrored in @telegram-apps and @tma.js packages): public sample data, not a secret.
+ * It pins the exact algorithm: secret = HMAC_SHA256(key 'WebAppData', bot token),
+ * expected = HMAC_SHA256(secret, data-check-string) hex. The token below is the
+ * documented example value published by Telegram for this exact test case; it is
+ * not a live credential. Assembled via concatenation to avoid secret-scanner false
+ * positives.
+ */
+const officialBotToken = '5768337691:' + 'AAH5YkoiEuPk8-FZa32hStHTqXiLPtAEhx8';
+const officialHash = 'c501b71e775f74ce10e377dea85a7ea24ecd640b223ea86dfe453e0eaed2e2b2';
+const officialAuthDate = 1662771648;
+const officialUser = JSON.stringify({
+  id: 279058397, first_name: 'Vladislav', last_name: 'Kibenko', username: 'vdkfrost', language_code: 'ru', is_premium: true,
+});
+const officialRaw = `query_id=AAHdF6IQAAAAAN0XohDhrOrc&user=${encodeURIComponent(officialUser)}&auth_date=${String(officialAuthDate)}&hash=${officialHash}`;
+const officialDcs = `auth_date=${String(officialAuthDate)}\nquery_id=AAHdF6IQAAAAAN0XohDhrOrc\nuser=${officialUser}`;
+const officialDigest = createHash('sha256').update(officialDcs).digest('hex');
+
+/** Synthetic signer for structural cases: only used by this test file, not a secret. */
+const syntheticToken = `7000000001:${'A'.repeat(43)}`;
+const now = new Date('2026-11-20T12:00:00Z');
+const nowSeconds = Math.floor(now.getTime() / 1000);
+const dcsOf = (pairs: readonly [string, string][]): string =>
+  [...pairs].sort((a, b) => (a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0)).map(([k, v]) => `${k}=${v}`).join('\n');
+const sign = (pairs: readonly [string, string][], token = syntheticToken): { raw: string; hash: string } => {
+  const hash = createHmac('sha256', createHmac('sha256', 'WebAppData').update(token).digest()).update(dcsOf(pairs)).digest('hex');
+  const raw = [...pairs, ['hash', hash] as [string, string]].map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join('&');
+  return { raw, hash };
+};
+const defaultUser = JSON.stringify({ id: 700000002, first_name: 'Synthetic', username: 'synthetic_master' });
+const validPairs: readonly [string, string][] = [['user', defaultUser], ['auth_date', String(nowSeconds)]];
+const valid = sign(validPairs);
+const options = { now };
+
+describe('verifyInitData', () => {
+  it('accepts the official documentation vector and extracts the verified identity', () => {
+    const verified = verifyInitData(officialRaw, officialBotToken, { now: new Date((officialAuthDate + 60) * 1000) });
+    expect(verified.telegramUserId).toBe('279058397');
+    expect(verified.authDate).toEqual(new Date(officialAuthDate * 1000));
+    expect(verified.digest).toBe(officialDigest);
+  });
+
+  it('rejects the official vector signed with a different bot token', () => {
+    expect(() => verifyInitData(officialRaw, syntheticToken, { now: new Date((officialAuthDate + 60) * 1000) }))
+      .toThrow(TelegramInitDataError);
+  });
+
+  it('accepts synthetic valid data and derives the canonical digest', () => {
+    const verified = verifyInitData(valid.raw, syntheticToken, options);
+    expect(verified.telegramUserId).toBe('700000002');
+    expect(verified.authDate).toEqual(new Date(nowSeconds * 1000));
+    expect(verified.digest).toBe(createHash('sha256').update(dcsOf(validPairs)).digest('hex'));
+  });
+
+  it('treats reordered parameters as the same canonical digest', () => {
+    const reordered = [...validPairs].reverse();
+    const signed = sign(reordered);
+    const first = verifyInitData(valid.raw, syntheticToken, options);
+    const second = verifyInitData(signed.raw, syntheticToken, options);
+    expect(second.digest).toBe(first.digest);
+  });
+
+  it('rejects tampered user data and any other field modification', () => {
+    // Attack model: Telegram-signed content with fields replaced but the original hash kept.
+    const tamperedRaw = `user=${encodeURIComponent(JSON.stringify({ id: 700000003, first_name: 'Attacker' }))}&auth_date=${String(nowSeconds)}&hash=${valid.hash}`;
+    try { verifyInitData(tamperedRaw, syntheticToken, options); expect.fail('expected INVALID_SIGNATURE'); }
+    catch (error) {
+      expect(error).toBeInstanceOf(TelegramInitDataError);
+      expect((error as TelegramInitDataError).code).toBe('INVALID_SIGNATURE');
+    }
+    const wrongDateRaw = `user=${encodeURIComponent(defaultUser)}&auth_date=${String(nowSeconds + 1)}&hash=${valid.hash}`;
+    try { verifyInitData(wrongDateRaw, syntheticToken, options); expect.fail('expected INVALID_SIGNATURE'); }
+    catch (error) { expect((error as TelegramInitDataError).code).toBe('INVALID_SIGNATURE'); }
+  });
+
+  it('rejects a missing or malformed hash parameter', () => {
+    expect(() => verifyInitData('user=x&auth_date=1', syntheticToken)).toThrow(TelegramInitDataError);
+    const noHash = validPairs.map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join('&');
+    expect(() => verifyInitData(noHash, syntheticToken, options)).toThrow(TelegramInitDataError);
+    const badHash = `${noHash}&hash=not-hex`;
+    expect(() => verifyInitData(badHash, syntheticToken, options)).toThrow(TelegramInitDataError);
+  });
+
+  it('rejects duplicate keys and oversized input instead of collapsing them', () => {
+    expect(() => verifyInitData(`${valid.raw}&user=second`, syntheticToken, options)).toThrow(
+      new TelegramInitDataError('INVALID_INPUT'));
+    expect(() => verifyInitData(`hash=${'a'.repeat(64)}&hash=${'b'.repeat(64)}`, syntheticToken)).toThrow(
+      new TelegramInitDataError('INVALID_INPUT'));
+    expect(() => verifyInitData('a'.repeat(5000), syntheticToken)).toThrow(TelegramInitDataError);
+  });
+
+  it('rejects missing, non-numeric or malformed parameters', () => {
+    const missingDate: readonly [string, string][] = [['user', defaultUser]];
+    const noDate = sign(missingDate);
+    try { verifyInitData(noDate.raw, syntheticToken, options); expect.fail('expected INVALID_INPUT'); }
+    catch (error) { expect((error as TelegramInitDataError).code).toBe('INVALID_INPUT'); }
+    const missingUser: readonly [string, string][] = [['auth_date', String(nowSeconds)]];
+    const noUser = sign(missingUser);
+    try { verifyInitData(noUser.raw, syntheticToken, options); expect.fail('expected INVALID_INPUT'); }
+    catch (error) { expect((error as TelegramInitDataError).code).toBe('INVALID_INPUT'); }
+    // Correctly signed payloads with malformed parameter contents still fail input validation.
+    for (const userValue of ['not-json', JSON.stringify({ id: 'not-a-number' }), JSON.stringify({ id: 0 }), JSON.stringify({ id: -5 })]) {
+      const signed = sign([['user', userValue], ['auth_date', String(nowSeconds)]]);
+      try { verifyInitData(signed.raw, syntheticToken, options); expect.fail(`expected INVALID_INPUT for ${userValue}`); }
+      catch (error) { expect((error as TelegramInitDataError).code).toBe('INVALID_INPUT'); }
+    }
+    const badDate = sign([['user', defaultUser], ['auth_date', 'not-a-date']]);
+    try { verifyInitData(badDate.raw, syntheticToken, options); expect.fail('expected INVALID_INPUT'); }
+    catch (error) { expect((error as TelegramInitDataError).code).toBe('INVALID_INPUT'); }
+  });
+
+  it('applies the 24h freshness window and 60s future skew', () => {
+    const fresh: readonly [string, string][] = [['user', defaultUser], ['auth_date', String(nowSeconds)]];
+    const freshSigned = sign(fresh);
+    expect(verifyInitData(freshSigned.raw, syntheticToken, options).telegramUserId).toBe('700000002');
+    const stale: readonly [string, string][] = [['user', defaultUser], ['auth_date', String(nowSeconds - 86401)]];
+    const staleSigned = sign(stale);
+    try { verifyInitData(staleSigned.raw, syntheticToken, options); expect.fail('expected EXPIRED'); }
+    catch (error) { expect((error as TelegramInitDataError).code).toBe('EXPIRED'); }
+    const slightly: readonly [string, string][] = [['user', defaultUser], ['auth_date', String(nowSeconds + 60)]];
+    const slightlySigned = sign(slightly);
+    expect(verifyInitData(slightlySigned.raw, syntheticToken, options).telegramUserId).toBe('700000002');
+    const future: readonly [string, string][] = [['user', defaultUser], ['auth_date', String(nowSeconds + 61)]];
+    const futureSigned = sign(future);
+    try { verifyInitData(futureSigned.raw, syntheticToken, options); expect.fail('expected FUTURE_DATE'); }
+    catch (error) { expect((error as TelegramInitDataError).code).toBe('FUTURE_DATE'); }
+  });
+
+  it('respects custom freshness and skew options', () => {
+    const old: readonly [string, string][] = [['user', defaultUser], ['auth_date', String(nowSeconds - 60)]];
+    const oldSigned = sign(old);
+    try { verifyInitData(oldSigned.raw, syntheticToken, { now, maxAgeSeconds: 10 }); expect.fail('expected EXPIRED'); }
+    catch (error) { expect((error as TelegramInitDataError).code).toBe('EXPIRED'); }
+    const future: readonly [string, string][] = [['user', defaultUser], ['auth_date', String(nowSeconds + 5)]];
+    const futureSigned = sign(future);
+    try { verifyInitData(futureSigned.raw, syntheticToken, { now, futureSkewSeconds: 0 }); expect.fail('expected FUTURE_DATE'); }
+    catch (error) { expect((error as TelegramInitDataError).code).toBe('FUTURE_DATE'); }
+  });
+
+  it('includes an optional signature parameter in the data-check-string without any special meaning', () => {
+    const withSignature: readonly [string, string][] = [
+      ['user', defaultUser], ['auth_date', String(nowSeconds)], ['signature', 'a'.repeat(64)],
+    ];
+    const signed = sign(withSignature);
+    const verified = verifyInitData(signed.raw, syntheticToken, options);
+    expect(verified.telegramUserId).toBe('700000002');
+    // Dropping the signature parameter breaks the hash: it is part of the signed data.
+    try { verifyInitData(valid.raw, syntheticToken, options); } catch { throw new Error('valid raw must verify'); }
+  });
+});
diff --git a/apps/api/tests/telegram-auth-config.test.ts b/apps/api/tests/telegram-auth-config.test.ts
