+  @Post(':id/deactivate') @HttpCode(200) @RequireCapability('staff.manage') @Header('Cache-Control', 'no-store')
+  async deactivate(@Req() req: StaffRequest & AuthorizedRequest, @Param('id') id: string, @Res({ passthrough: true }) res: ServerResponse) {
