+interface StaffStateRow { role: string; employment_state: string; auth_version: number }
+
+interface DeactivatedDto { id: string; role: string; employmentState: string }
+
+/** Validates the deactivation envelope into a typed DTO; no `any` crosses this boundary. */
+function deactivatedDto(body: unknown): DeactivatedDto {
+  if (typeof body !== 'object' || body === null || !('data' in body) || typeof body.data !== 'object' || body.data === null) { throw new Error('Missing deactivation data'); }
+  const data = body.data as Record<string, unknown>;
+  const id = data['id'];
+  const role = data['role'];
+  const employmentState = data['employmentState'];
+  if (typeof id !== 'string' || typeof role !== 'string' || typeof employmentState !== 'string') { throw new Error('Invalid deactivation data'); }
+  return { id, role, employmentState };
+}
+
+function createdId(body: unknown): string {
+  if (typeof body !== 'object' || body === null || !('data' in body) || typeof body.data !== 'object' || body.data === null || !('id' in body.data) || typeof body.data.id !== 'string') { throw new Error('Missing created staff id'); }
+  return body.data.id;
+}
