// Append-only business event; UNIQUE(principal,operation,idempotency_key) is
// the durable command identity of the idempotency contract.
model RequestEvent {
  id               String   @id @db.Uuid
  requestId        String   @map("request_id") @db.Uuid
  command          String   @db.VarChar(64)
  principal        String   @db.VarChar(160)
  operation        String   @db.VarChar(64)
  idempotencyKey   String   @map("idempotency_key") @db.Uuid
  actorType        String   @map("actor_type") @db.VarChar(12)
  actorSessionId   String?  @map("actor_session_id") @db.Uuid
  actorStaffId     String?  @map("actor_staff_id") @db.Uuid
  resultingVersion Int      @map("resulting_version")
  correlationId    String   @map("correlation_id") @db.Uuid
  details          Json     @default("{}")
  createdAt        DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  request          Request @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "request_events_request_id_fkey")
  actorSession     RequestSession? @relation(fields: [actorSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "request_events_actor_session_id_fkey")
  actorStaff       Staff? @relation("RequestEventActor", fields: [actorStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "request_events_actor_staff_id_fkey")
  // Inverse sides are lists even where SQL makes the pair unique: Prisma demands a
  // source-side unique to accept 1:1, and inventing one would add an index the
  // reviewed SQL does not have. The real uniqueness stays in migration 024.
  commandReceipts  RequestCommandReceipt[]
  sessionSubmits   RequestSessionSubmit[] @relation("RequestEventSessionSubmits")

  @@unique([principal, operation, idempotencyKey], map: "request_events_principal_operation_key_key")
  @@unique([requestId, resultingVersion], map: "request_events_request_version_key")
  @@unique([id, requestId, resultingVersion, correlationId, command], map: "request_events_receipt_tuple_key")
  @@unique([id, requestId, command, actorSessionId], map: "request_events_form_submit_key")
  @@index([requestId, createdAt], map: "request_events_request_idx")
  @@map("request_events")
  @@schema("foundation")
}

// P05-02 opaque browser group: a server-side hash of an opaque grouping secret
// plus a trusted expiry window. Not an F-session and not an identity; no PII,
// no revoke. Expiry is decided by comparing the stored timestamps with the
// database clock, so the row always stays: UPDATE and DELETE are refused by the
// form_browser_groups_guard trigger (23514), which also pins created_at to the
// database clock on every INSERT. Expired groups are never deleted either:
// form session group memberships outlive as history and reference them.
model FormBrowserGroup {
  id          String   @id @db.Uuid
  secretHash  String   @unique(map: "form_browser_groups_secret_hash_key") @map("secret_hash") @db.VarChar(64)
  createdAt   DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  memberships FormSessionGroupMembership[]

  @@map("form_browser_groups")
  @@schema("foundation")
}

// P05-02 form session group membership (S2): the thin 1:1 mapping of a
// request_sessions.id issued through the F protocol to its browser group.
// session_id is both the primary key and the P03 anchor reference — there is
// no second anchor id, no second secret hash and no own expiry, revoke or
// intake pair here; the anchor secret, expiry and provenance keep living in
// request_sessions (013), so the same F token keeps authorizing
// reserveFileUpload (014) and consent_records (013). The
// form_session_group_memberships_guard trigger (23514) requires the browser
// group and a live (unrevoked, unexpired) request session to exist, pins the
// anchor expiry to the group expiry and pins created_at to the database clock
// on INSERT; UPDATE and DELETE are refused.
model FormSessionGroupMembership {
  sessionId String   @id @map("session_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  group     FormBrowserGroup @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  session   RequestSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([groupId], map: "form_session_group_memberships_group_id_idx")
  @@map("form_session_group_memberships")
  @@schema("foundation")
}

// P05-02 bounded fixed-window throttle counters for the form session issuance
// paths. A bucket is a keyed counter, not a policy and not PII. Identity and
// window columns are immutable, hit_count can only grow or stay (the
// form_throttle_buckets_guard trigger refuses a decrease and any DELETE); a new
// window is a new row keyed by UNIQUE(kind,key_hash,window_started_at).
model FormThrottleBucket {
  id              String   @id @db.Uuid
  kind            String   @db.VarChar(16)
  keyHash         String   @map("key_hash") @db.VarChar(64)
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  windowSeconds   Int      @map("window_seconds")
  hitCount        Int      @map("hit_count")

  @@unique([kind, keyHash, windowStartedAt], map: "form_throttle_buckets_kind_key_hash_window_started_at_key")
  @@map("form_throttle_buckets")
  @@schema("foundation")
}

// ---------------------------------------------------------------------------
// P05-03/P05-04 (S3, migration 024 request_intake_effects): command evidence,
// submit receipts, phone permission, attachment interlock, coverage basis and
// manual provenance. These are the tables the Prisma layer of P05 writes and
// reads; every guard, immutability trigger, exact runtime column ACL and
// deferred completeness constraint lives only in migration 024 SQL.
//
// Naming contract for this block: `onDelete: Restrict` wherever the SQL says
// ON DELETE RESTRICT, and `onUpdate: NoAction` wherever the SQL omits the
// ON UPDATE clause (PostgreSQL then stores NO ACTION, which is a different
// catalog value than RESTRICT). The single exception is
// request_files.intent_id -> open_state, which SQL declares ON UPDATE RESTRICT.
//
// Three things stay SQL-only and must not be "fixed" by regenerating this
// schema: partial unique indexes (WHERE ...), CHECK constraints, and
// DEFERRABLE INITIALLY DEFERRED foreign keys.
// ---------------------------------------------------------------------------

// Staff-side intake evidence: the exact reviewed procedure revision and the
// declaration window a manual/no-call command was taken under. Append-only.
// `request_staff_one_source_key` is a PARTIAL unique index
// (WHERE purpose='MANUAL_INTAKE'): one request has at most one manual source.
model RequestStaffEvidence {
  id                String   @id @db.Uuid
  requestId         String   @map("request_id") @db.Uuid
  staffId           String   @map("staff_id") @db.Uuid
  purpose           String   @db.VarChar(32)
  procedureRevision String   @map("procedure_revision") @db.VarChar(68)
  validUntil        DateTime @map("valid_until") @db.Timestamptz(6)
  declaredAt        DateTime @default(dbgenerated("clock_timestamp()")) @map("declared_at") @db.Timestamptz(6)
  request           Request  @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  staff             Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  phonePermissions  PhonePermissionEvent[]

  @@unique([id, requestId])
  @@map("request_staff_evidence")
  @@schema("foundation")
}

// Durable command identity next to the receipt: one row per committed command
// event, bound to the exact request event tuple and to its own audit/outbox rows.
// The audit_id/outbox_id uniques make a second receipt for the same evidence
// impossible; the composite FK pins (event, request, version, correlation, command).
model RequestCommandReceipt {
  eventId             String   @id @map("event_id") @db.Uuid
  requestId           String   @map("request_id") @db.Uuid
  version             Int
  correlationId       String   @map("correlation_id") @db.Uuid
  command             String   @db.VarChar(64)
  keyId               String   @map("key_id") @db.VarChar(64)
  fingerprint         Bytes
  resultingStatus     String   @map("resulting_status") @db.VarChar(32)
  auditId             String   @unique(map: "request_command_receipts_audit_id_key") @map("audit_id") @db.Uuid
  outboxId            String   @unique(map: "request_command_receipts_outbox_id_key") @map("outbox_id") @db.Uuid
  event               RequestEvent @relation(fields: [eventId, requestId, version, correlationId, command], references: [id, requestId, resultingVersion, correlationId, command], onDelete: Restrict, onUpdate: NoAction)
  audit               AuditLog @relation(fields: [auditId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  outbox              OutboxEvent @relation(fields: [outboxId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sessionSubmits      RequestSessionSubmit[]
  phonePermissions    PhonePermissionEvent[]
  coverageAssessments RequestCoverageAssessment[]

  @@unique([eventId, requestId])
  @@map("request_command_receipts")
  @@schema("foundation")
}

// F-origin submit edge: exactly one immutable row per consumed F anchor and per
// request. It binds the anchor tuple, the exact consent basis, the city/version
// pair and the submit event, so an F submit cannot be re-pointed at another
// request, city, customer or consent after the fact.
model RequestSessionSubmit {
  sessionId           String   @id @map("session_id") @db.Uuid
  requestId           String   @unique(map: "request_session_submits_request_id_key") @map("request_id") @db.Uuid
  customerId          String   @map("customer_id") @db.Uuid
  intakeCityId        String   @map("intake_city_id") @db.Uuid
  intakeCityVersionId String   @map("intake_city_version_id") @db.Uuid
  consentId           String   @map("consent_id") @db.Uuid
  documentId          String   @map("document_id") @db.Uuid
  documentVersionId   String   @map("document_version_id") @db.Uuid
  purpose             String   @default("REQUEST_PROCESSING") @db.VarChar(32)
  action              String   @default("GIVEN") @db.VarChar(16)
  eventId             String   @unique(map: "request_session_submits_event_id_key") @map("event_id") @db.Uuid
  submitCommand       String   @map("submit_command") @db.VarChar(64)
  cityPairRequest     Request  @relation("RequestSessionSubmitCityPair", fields: [requestId, intakeCityId, intakeCityVersionId], references: [id, cityId, intakeCityVersionId], onDelete: Restrict, onUpdate: NoAction)
  customerPairRequest Request  @relation("RequestSessionSubmitCustomer", fields: [requestId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: NoAction)
  anchorPair          RequestSession @relation("RequestSessionSubmitAnchor", fields: [sessionId, intakeCityId, intakeCityVersionId], references: [id, intakeCityId, intakeCityVersionId], onDelete: Restrict, onUpdate: NoAction)
  consent             ConsentRecord @relation(fields: [consentId, sessionId, documentId, documentVersionId, purpose, action], references: [id, sessionId, documentId, documentVersionId, purpose, action], onDelete: Restrict, onUpdate: NoAction)
  event               RequestEvent @relation("RequestEventSessionSubmits", fields: [eventId, requestId, submitCommand, sessionId], references: [id, requestId, command, actorSessionId], onDelete: Restrict, onUpdate: NoAction)
  receipt             RequestCommandReceipt @relation(fields: [eventId, requestId], references: [eventId, requestId], onDelete: Restrict, onUpdate: NoAction)
  files               RequestFile[]

  @@unique([requestId, sessionId])
  @@map("request_session_submits")
  @@schema("foundation")
}

// Append-only PHONE permission history (§4.4). GIVEN carries no supersedes id;
// REVOKED must name the exact GIVEN row of the same request/contact/purpose, so
// one GIVEN has at most one REVOKED. `request_one_phone_given_key` is a PARTIAL
// unique index (WHERE action='GIVEN'): one live GIVEN per contact revision.
model PhonePermissionEvent {
  id                String   @id @db.Uuid
  requestId         String   @map("request_id") @db.Uuid
  contactRevisionId String   @map("contact_revision_id") @db.Uuid
  purpose           String   @default("REQUEST_SERVICE_CALL") @db.VarChar(32)
  action            String   @db.VarChar(16)
  supersedesGivenId String?  @unique(map: "phone_permission_events_supersedes_given_id_key") @map("supersedes_given_id") @db.Uuid
  givenAction       String   @default("GIVEN") @map("given_action") @db.VarChar(16)
  eventId           String   @unique(map: "phone_permission_events_event_id_key") @map("event_id") @db.Uuid
  staffEvidenceId   String?  @map("staff_evidence_id") @db.Uuid
  occurredAt        DateTime @default(dbgenerated("clock_timestamp()")) @map("occurred_at") @db.Timestamptz(6)
  contactRevision   RequestContactRevision @relation(fields: [requestId, contactRevisionId], references: [requestId, id], onDelete: Restrict, onUpdate: NoAction)
  supersedes        PhonePermissionEvent? @relation("PhonePermissionSupersedes", fields: [supersedesGivenId, requestId, contactRevisionId, purpose, givenAction], references: [id, requestId, contactRevisionId, purpose, action], onDelete: Restrict, onUpdate: NoAction)
  supersededBy      PhonePermissionEvent[] @relation("PhonePermissionSupersedes")
  receipt           RequestCommandReceipt @relation(fields: [eventId, requestId], references: [eventId, requestId], onDelete: Restrict, onUpdate: NoAction)
  staffEvidence     RequestStaffEvidence? @relation(fields: [staffEvidenceId, requestId], references: [id, requestId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([id, requestId, contactRevisionId, purpose, action])
  @@map("phone_permission_events")
  @@schema("foundation")
}

// P05 attachment interlock (§5.2): one READY publication per request, exactly
// once. The (intent_id, open_state) FK to file_privacy_controls(intent_id,
// delete_state) with open_state pinned to 'OPEN' is the DB backstop that makes an
// attachment impossible while the intent is not OPEN — including a concurrent
// OPEN -> PENDING_LEDGER transition by the old writer.
model RequestFile {
  requestId      String @map("request_id") @db.Uuid
  ownerSessionId String @map("owner_session_id") @db.Uuid
  intentId       String @unique(map: "request_files_intent_id_key") @map("intent_id") @db.Uuid
  fileId         String @unique(map: "request_files_file_id_key") @map("file_id") @db.Uuid
  openState      String @default("OPEN") @map("open_state") @db.VarChar(24)
  submit         RequestSessionSubmit @relation(fields: [requestId, ownerSessionId], references: [requestId, sessionId], onDelete: Restrict, onUpdate: NoAction)
  intent         FileUploadIntent @relation(fields: [intentId, ownerSessionId], references: [id, ownerRequestSessionId], onDelete: Restrict, onUpdate: NoAction)
  publication    FilePublication @relation(fields: [intentId, fileId], references: [intentId, id], onDelete: Restrict, onUpdate: NoAction)
  privacyControl FilePrivacyControl @relation(fields: [intentId, openState], references: [intentId, deleteState], onDelete: Restrict, onUpdate: Restrict)

  @@id([requestId, fileId])
  @@map("request_files")
  @@schema("foundation")
}

// Exact reviewed brand (and brand version) snapshot of one appliance revision.
// The entry/version FKs are kind-scoped so a brand cannot be pinned to another
// catalog kind.
model RequestApplianceBrand {
  applianceRevisionId String @id @map("appliance_revision_id") @db.Uuid
  requestId           String @map("request_id") @db.Uuid
  brandId             String @map("brand_id") @db.Uuid
  brandKind           String @default("BRAND") @map("brand_kind") @db.VarChar(16)
  brandVersionId      String @map("brand_version_id") @db.Uuid
  applianceRevision   RequestApplianceRevision @relation(fields: [requestId, applianceRevisionId], references: [requestId, id], onDelete: Restrict, onUpdate: NoAction)
  brandEntry          CatalogDirectoryEntry @relation("RequestApplianceBrandEntry", fields: [brandId, brandKind], references: [id, kind], onDelete: Restrict, onUpdate: NoAction)
  brandVersion        CatalogDirectoryVersion @relation("RequestApplianceBrandVersion", fields: [brandId, brandVersionId], references: [entryId, id], onDelete: Restrict, onUpdate: NoAction)

  @@map("request_appliance_brands")
  @@schema("foundation")
}

// The admitted no-call channel choice of a request: exactly one per request, with
// the catalog/option/readiness basis it was verified against.
model RequestChannelChoice {
  requestId        String   @id @map("request_id") @db.Uuid
  provider         String   @db.VarChar(8)
  catalogVersionId String   @map("catalog_version_id") @db.Uuid
  optionVersionId  String   @map("option_version_id") @db.Uuid
  readinessBasisId String   @map("readiness_basis_id") @db.Uuid
  checkedAt        DateTime @default(dbgenerated("clock_timestamp()")) @map("checked_at") @db.Timestamptz(6)
  request          Request  @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("request_channel_choices")
  @@schema("foundation")
}

// Bounded append-only audit of one address-coverage review attempt. It is
// committed on a separate guarded connection BEFORE the plaintext comparison, so
// it deliberately has NO foreign key to the request or the address revision.
model RequestAddressReviewAttempt {
  evidenceId        String   @id @map("evidence_id") @db.Uuid
  staffId           String   @map("staff_id") @db.Uuid
  requestId         String   @map("request_id") @db.Uuid
  addressRevisionId String   @map("address_revision_id") @db.Uuid
  purpose           String   @db.VarChar(24)
  correlationId     String   @unique(map: "request_address_review_attempts_correlation_id_key") @map("correlation_id") @db.Uuid
  occurredAt        DateTime @default(dbgenerated("clock_timestamp()")) @map("occurred_at") @db.Timestamptz(6)
  assessments       RequestCoverageAssessment[]

  @@unique([correlationId, requestId, addressRevisionId, staffId], map: "request_address_review_attemp_correlation_id_request_id_add_key")
  @@map("request_address_review_attempts")
  @@schema("foundation")
}

// Immutable coverage assessment (§5.1): the exact address revision, the city and
// city version, the selected same-city area version, the digest of the whole
// normalized basis and the outcome/reason pair. The DB CHECKs in migration 024
// enforce area_id <-> area_version_id and the outcome/reason combinations; the
// attempt_correlation_id FK proves a committed review attempt exists first.
model RequestCoverageAssessment {
  id                   String   @id @db.Uuid
  requestId            String   @map("request_id") @db.Uuid
  addressRevisionId    String   @map("address_revision_id") @db.Uuid
  cityId               String   @map("city_id") @db.Uuid
  cityVersionId        String   @map("city_version_id") @db.Uuid
  areaId               String?  @map("area_id") @db.Uuid
  areaVersionId        String?  @map("area_version_id") @db.Uuid
  basisDigest          String   @map("basis_digest") @db.VarChar(64)
  outcome              String   @db.VarChar(16)
  reason               String?  @db.VarChar(24)
  staffId              String   @map("staff_id") @db.Uuid
  attemptCorrelationId String   @unique(map: "request_coverage_assessments_attempt_correlation_id_key") @map("attempt_correlation_id") @db.Uuid
  eventId              String   @unique(map: "request_coverage_assessments_event_id_key") @map("event_id") @db.Uuid
  createdAt            DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  addressRevision      RequestAddressRevision @relation(fields: [requestId, addressRevisionId], references: [requestId, id], onDelete: Restrict, onUpdate: NoAction)
  cityVersion          ServiceCityVersion @relation("RequestCoverageAssessmentCityVersion", fields: [cityId, cityVersionId], references: [cityId, id], onDelete: Restrict, onUpdate: NoAction)
  areaVersion          ServiceAreaVersion? @relation("RequestCoverageAssessmentAreaVersion", fields: [areaId, cityId, areaVersionId], references: [areaId, cityId, id], onDelete: Restrict, onUpdate: NoAction)
  cityPairRequest      Request  @relation("RequestCoverageAssessmentCity", fields: [requestId, cityId], references: [id, cityId], onDelete: Restrict, onUpdate: NoAction)
  attempt              RequestAddressReviewAttempt @relation(fields: [attemptCorrelationId, requestId, addressRevisionId, staffId], references: [correlationId, requestId, addressRevisionId, staffId], onDelete: Restrict, onUpdate: NoAction)
  staff                Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  receipt              RequestCommandReceipt @relation(fields: [eventId, requestId], references: [eventId, requestId], onDelete: Restrict, onUpdate: NoAction)
  currentFor           Request[] @relation("RequestCurrentAssessment")

  @@unique([requestId, addressRevisionId, id])
  @@map("request_coverage_assessments")
  @@schema("foundation")
}

// Manual intake provenance: the exact reviewed source entry/version and the
// optional callback-interval reference, both kind-scoped to reference entries.
model RequestIntakeProvenance {
  requestId         String  @id @map("request_id") @db.Uuid
  sourceEntryId     String  @map("source_entry_id") @db.Uuid
  sourceVersionId   String  @map("source_version_id") @db.Uuid
  sourceType        String  @default("REQUEST_SOURCE") @map("source_type") @db.VarChar(32)
  callbackEntryId   String? @map("callback_entry_id") @db.Uuid
  callbackVersionId String? @map("callback_version_id") @db.Uuid
  callbackType      String  @default("CALLBACK_INTERVAL") @map("callback_type") @db.VarChar(32)
  request           Request @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  source            ReferenceEntryVersion @relation("IntakeProvenanceSource", fields: [sourceEntryId, sourceType, sourceVersionId], references: [entryId, type, id], onDelete: Restrict, onUpdate: NoAction)
  callback          ReferenceEntryVersion? @relation("IntakeProvenanceCallback", fields: [callbackEntryId, callbackType, callbackVersionId], references: [entryId, type, id], onDelete: Restrict, onUpdate: NoAction)

  @@map("request_intake_provenance")
  @@schema("foundation")
}
