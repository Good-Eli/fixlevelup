  assessmentCityPair          RequestCoverageAssessment[] @relation("RequestCoverageAssessmentCity")
  intakeProvenance            RequestIntakeProvenance?

  @@unique([publicNumber], map: "requests_public_number_key")
  @@unique([id, customerId], map: "requests_id_customer_id_key")
  @@unique([id, cityId], map: "requests_id_city_key")
  @@unique([id, cityId, intakeCityVersionId], map: "requests_id_city_id_intake_city_version_id_key")
  @@unique([id, currentContactRevisionId], map: "requests_current_contact_key")
  @@unique([id, currentAddressRevisionId], map: "requests_current_address_key")
  @@unique([id, currentApplianceRevisionId], map: "requests_current_appliance_key")
  @@unique([id, currentPreferenceRevisionId], map: "requests_current_preference_key")
  @@index([customerId], map: "requests_customer_id_idx")
  @@map("requests")
  @@schema("foundation")
}

