  @@id([assignmentId, permissionCode])
  @@map("p04_bootstrap_permissions")
  @@schema("foundation")
}

// Immutable command evidence; subject/entity/revision targets are polymorphic.
// SQL checks the closed operation set and exact shape, and runtime resolves the
// polymorphic IDs with operation-specific authority rather than generic joins.
model P04CommandReceipt {
  actorId         String       @map("actor_id") @db.Uuid
  operation       String       @db.VarChar(64)
  key             String       @db.Uuid
  requestSha256   String       @map("request_sha256") @db.VarChar(64)
  cityId          String?      @map("city_id") @db.Uuid
  subjectId       String       @map("subject_id") @db.Uuid
  targetVersionId String?      @map("target_version_id") @db.Uuid
  entityId        String       @map("entity_id") @db.Uuid
  entityVersion   Int          @map("entity_version")
  revisionId      String?      @map("revision_id") @db.Uuid
  revisionVersion Int?         @map("revision_version")
  createdAt       DateTime     @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  actor           Staff        @relation("P04ReceiptActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  city            ServiceCity? @relation("P04ReceiptCity", fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([actorId, operation, key])
  @@map("p04_command_receipts")
  @@schema("foundation")
}

enum ExternalReviewKind {
  PROFILE
  REVIEW

  @@map("external_review_kind")
  @@schema("foundation")
}

// Stable manual Avito identity. The same-owner pointer and fixed PROFILE parent
// are typed FKs; archiving never deletes the identity or its published history.
model ExternalReview {
  id               String                  @id @db.Uuid
  code             String                  @db.VarChar(64)
  kind             ExternalReviewKind
  profileId        String?                 @map("profile_id") @db.Uuid
  profileKind      ExternalReviewKind      @default(PROFILE) @map("profile_kind")
  currentVersionId String?                 @map("current_version_id") @db.Uuid
  rowVersion       Int                     @default(1) @map("row_version")
  archivedAt       DateTime?               @map("archived_at") @db.Timestamptz(6)
  profile          ExternalReview?         @relation("ExternalReviewProfile", fields: [profileId, profileKind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict, map: "external_reviews_profile_fkey")
  reviewEntries    ExternalReview[]        @relation("ExternalReviewProfile")
  currentVersion   ExternalReviewRevision? @relation("ExternalReviewCurrentVersion", fields: [id, kind, currentVersionId], references: [entryId, kind, id], onDelete: Restrict, onUpdate: Restrict, map: "external_reviews_current_version_fkey")
  versions         ExternalReviewRevision[] @relation("ExternalReviewVersions")

  @@unique([kind, code], map: "external_reviews_kind_code_key")
  @@unique([id, kind], map: "external_reviews_id_kind_key")
  @@map("external_reviews")
  @@schema("foundation")
}

// Immutable publication. For a REVIEW, the composite self-FK records the exact
// revision of its PROFILE parent; SQL pins the owner and current/live basis.
model ExternalReviewRevision {
  id                String                   @id @db.Uuid
  entryId           String                   @map("entry_id") @db.Uuid
  kind              ExternalReviewKind
  version           Int
  title             String
  sourceUrl         String                   @map("source_url")
  sourceDate        DateTime?                @map("source_date") @db.Date
  excerpt           String?
  rating            Int?
  permissionRef     String                   @map("permission_ref")
  profileRevisionId String?                  @map("profile_revision_id") @db.Uuid
  reviewedBy        String                   @map("reviewed_by") @db.Uuid
  publishedAt       DateTime                 @default(dbgenerated("clock_timestamp()")) @map("published_at") @db.Timestamptz(6)
  profileId         String?                  @map("profile_id") @db.Uuid
  profileKind       ExternalReviewKind       @default(PROFILE) @map("profile_kind")
  entry             ExternalReview           @relation("ExternalReviewVersions", fields: [entryId, kind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict, map: "external_review_revisions_entry_fkey")
  currentFor        ExternalReview[]         @relation("ExternalReviewCurrentVersion")
  profileRevision   ExternalReviewRevision?  @relation("ExternalReviewRevisionProfile", fields: [profileId, profileKind, profileRevisionId], references: [entryId, kind, id], onDelete: Restrict, onUpdate: Restrict, map: "external_review_revisions_profile_fkey")
  sourcedReviews    ExternalReviewRevision[] @relation("ExternalReviewRevisionProfile")
  reviewer          Staff                    @relation("ExternalReviewReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "external_review_revisions_reviewer_fkey")

  @@unique([entryId, version], map: "external_review_revisions_entry_version_key")
  @@unique([entryId, kind, id], map: "external_review_revisions_entry_kind_id_key")
  @@map("external_review_revisions")
  @@schema("foundation")
}

// ---------------------------------------------------------------------------
// P05-01 (022, schema profile S1): request intake foundation. Immutable policy
// packages, the business customer record, the request aggregate and its typed
// encrypted history. All SQL guards/triggers/grants live in migration 022.
// ---------------------------------------------------------------------------

// Reviewed intake/workflow policy metadata pair; versions are provisioned by
// the isolated test stand, never by a runtime seed. Append-only.
model RequestPolicyPackage {
  id              String   @id @db.Uuid
  // Migration 024 drops request_policy_packages_workflow_version_key: several
  // reviewed policy revisions may pin the same workflow package semantics, so the
  // workflow version is no longer unique on its own. The pair rule
  // (requests.workflow_package_id = requests.intake_policy_revision_id) is a CHECK
  // added by the same migration and lives only in SQL.
  workflowVersion String   @map("workflow_version") @db.VarChar(64)
  policyRevision  String   @map("policy_revision") @unique @db.VarChar(68)
  metadataSha256  String   @map("metadata_sha256") @db.VarChar(64)
  metadata        Json     @default("{}")
  createdAt       DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  requests           Request[] @relation("RequestWorkflowPackage")
  intakePolicyFor    Request[] @relation("RequestIntakePolicy")

  @@map("request_policy_packages")
  @@schema("foundation")
}

// Q03: a business record, not an auth principal. No plaintext personal column;
// every personal value lives in RequestPayloadCell ciphertext.
model Customer {
  id        String   @id @db.Uuid
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  requests  Request[]

  @@map("customers")
  @@schema("foundation")
}

// One random DEK per payload, wrapped under a versioned external KEK. The AAD
// is rebuilt from the immutable (request, kind, revision) identity.
model RequestPayloadCell {
  id         String   @id @db.Uuid
  requestId  String   @map("request_id") @db.Uuid
  kind       String   @db.VarChar(24)
  revision   Int
  keyId      String   @map("key_id") @db.VarChar(64)
  wrappedDek Bytes    @map("wrapped_dek")
  nonce      Bytes
  ciphertext Bytes
  authTag    Bytes    @map("auth_tag")
  aadContext String   @map("aad_context") @db.VarChar(128)
  createdAt  DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  request    Request @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "request_payload_cells_request_id_fkey")
  contacts   RequestContactRevision[]
  addresses  RequestAddressRevision[]
  appliances RequestApplianceRevision[]

  @@unique([requestId, kind, revision], map: "request_payload_cells_request_kind_revision_key")
  @@unique([requestId, id], map: "request_payload_cells_request_id_id_key")
  @@map("request_payload_cells")
  @@schema("foundation")
}

model Request {
  id                          String  @id @db.Uuid
  publicNumber                BigInt  @default(autoincrement()) @map("public_number")
  type                        String  @db.VarChar(16)
  status                      String  @db.VarChar(32)
  rowVersion                  Int     @default(1) @map("row_version")
  customerId                  String  @map("customer_id") @db.Uuid
  cityId                      String  @map("city_id") @db.Uuid
  intakeCityVersionId         String  @map("intake_city_version_id") @db.Uuid
  workflowPackageId           String  @map("workflow_package_id") @db.Uuid
  intakePolicyRevisionId      String  @map("intake_policy_revision_id") @db.Uuid
  currentContactRevisionId    String? @map("current_contact_revision_id") @db.Uuid
  currentAddressRevisionId    String? @map("current_address_revision_id") @db.Uuid
  currentApplianceRevisionId  String? @map("current_appliance_revision_id") @db.Uuid
  currentPreferenceRevisionId String? @map("current_preference_revision_id") @db.Uuid
  currentAssessmentId         String? @map("current_assessment_id") @db.Uuid
  createdAt                   DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  isWaitingLink               Boolean @default(dbgenerated("((status)::text = ANY ((ARRAY['WAITING_TELEGRAM_LINK'::character varying, 'WAITING_CHANNEL_LINK'::character varying])::text[]))")) @map("is_waiting_link")
  customer                    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "requests_customer_id_fkey")
