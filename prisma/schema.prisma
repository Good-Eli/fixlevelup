// A privately registered transfer attempt. Migration 015 owns the partial indexes,
// phase/probe CHECKs and transition guards, DB stamps, and runtime column ACLs.
model FileUploadAttempt {
  id                    String    @id @db.Uuid
  intentId              String    @map("intent_id") @db.Uuid
