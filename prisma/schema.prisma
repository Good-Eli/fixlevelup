  intakePolicyRevision        RequestPolicyPackage @relation("RequestIntakePolicy", fields: [intakePolicyRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "requests_intake_policy_revision_id_fkey")
  currentContactRevision      RequestContactRevision? @relation("RequestCurrentContact", fields: [id, currentContactRevisionId], references: [requestId, id], onDelete: Restrict, onUpdate: Restrict, map: "requests_current_contact_revision_fkey")
  currentAddressRevision      RequestAddressRevision? @relation("RequestCurrentAddress", fields: [id, currentAddressRevisionId], references: [requestId, id], onDelete: Restrict, onUpdate: Restrict, map: "requests_current_address_revision_fkey")
  currentApplianceRevision    RequestApplianceRevision? @relation("RequestCurrentAppliance", fields: [id, currentApplianceRevisionId], references: [requestId, id], onDelete: Restrict, onUpdate: Restrict, map: "requests_current_appliance_revision_fkey")
  currentPreferenceRevision   RequestPreferenceRevision? @relation("RequestCurrentPreference", fields: [id, currentPreferenceRevisionId], references: [requestId, id], onDelete: Restrict, onUpdate: Restrict, map: "requests_current_preference_revision_fkey")
  // Migration 024 adds current_assessment_id and a composite FK to
