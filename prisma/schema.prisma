  fault                CatalogDirectoryEntry? @relation("RequestFaultEntry", fields: [faultId, faultKind, categoryId], references: [id, kind, categoryId], onDelete: Restrict, onUpdate: Restrict, map: "request_faults_fault_entry_fkey")
