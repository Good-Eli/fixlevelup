  currentAssessment           RequestCoverageAssessment? @relation("RequestCurrentAssessment", fields: [id, currentAddressRevisionId, currentAssessmentId], references: [requestId, addressRevisionId, id], onDelete: Restrict, onUpdate: NoAction, map: "requests_current_assessment_fkey")
  payloadCells                RequestPayloadCell[]
  contacts                    RequestContactRevision[] @relation("RequestContactHistory")
  addresses                   RequestAddressRevision[] @relation("RequestAddressHistory")
  appliances                  RequestApplianceRevision[] @relation("RequestApplianceHistory")
  preferences                 RequestPreferenceRevision[]
