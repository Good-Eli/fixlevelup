  dispatchedAt          DateTime? @map("dispatched_at") @db.Timestamptz(6)
  verifiedBytes         BigInt?   @map("verified_bytes")
  verifiedSha256        String?   @map("verified_sha256") @db.VarChar(64)
  probeGeneration       Int       @default(0) @map("probe_generation")
