  observedAt            DateTime? @map("observed_at") @db.Timestamptz(6)
  observation           String?   @db.VarChar(24)
  observedBytes         BigInt?   @map("observed_bytes")
  observedSha256        String?   @map("observed_sha256") @db.VarChar(64)

  intent FileUploadIntent @relation(fields: [intentId, ownerRequestSessionId, chargedBytes], references: [id, ownerRequestSessionId, declaredBytes], onDelete: Restrict, onUpdate: Restrict, map: "file_upload_attempts_intent_basis_fkey")
