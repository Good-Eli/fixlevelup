generator client {
  provider               = "prisma-client"
  output                 = "../apps/api/src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["foundation"]
}

// Technical infrastructure, staff access and city settings. No customers or requests yet.
model AuditLog {
  id            String   @id @db.Uuid
  operation     String   @db.VarChar(64)
  correlationId String   @map("correlation_id") @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  details       Json     @default("{}") @db.JsonB

  @@map("audit_logs")
  @@schema("foundation")
}

model Staff {
  id              String              @id @db.Uuid
  role            String              @db.VarChar(16)
  employmentState String              @map("employment_state") @db.VarChar(16)
  authVersion        Int                   @default(0) @map("auth_version")
  displayName        String?               @map("display_name") @db.VarChar(80)
  profileVersion     Int                   @default(0) @map("profile_version")
  createdRoles       Role[]                @relation("RoleCreatedBy")
  updatedRoles       Role[]                @relation("RoleUpdatedBy")
  roleAssignments    StaffRoleAssignment[] @relation("RoleSubject")
  assignedRoles      StaffRoleAssignment[] @relation("RoleAssignedBy")
  revokedRoles       StaffRoleAssignment[] @relation("RoleRevokedBy")
  webCredential      StaffWebCredential?
  bootstrapMarker    StaffBootstrapMarker?
  webSessions          WebSession[]
  permissions          UserPermission[]
  grantedPermissions   UserPermission[]        @relation("UserPermissionGrantedBy")
  staffTelegramLinks   StaffTelegramLink[]
  linkedTelegramLinks  StaffTelegramLink[]     @relation("StaffTelegramLinkLinkedBy")
  reviewedCityVersions ServiceCityVersion[]    @relation("CityVersionReviewer")
  reviewedSettings     BusinessSettingsVersion[] @relation("BusinessSettingsReviewer")
  createdAreaVersions   ServiceAreaVersion[]    @relation("ServiceAreaVersionCreator")
  publishedAreaVersions ServiceAreaVersion[]    @relation("ServiceAreaVersionPublisher")
  cityAssignments       StaffAdminCityAssignment[]  @relation("AdminCityAssignmentSubject")
  grantedCityAssignments StaffAdminCityAssignment[] @relation("AdminCityAssignmentGrantor")
  revokedCityAssignments StaffAdminCityAssignment[] @relation("AdminCityAssignmentRevoker")
  cityMemberships        TechnicianCityMembership[] @relation("TechnicianCityMembershipSubject")
  approvedCityMemberships TechnicianCityMembership[] @relation("TechnicianCityMembershipApprover")
  revokedCityMemberships  TechnicianCityMembership[] @relation("TechnicianCityMembershipRevoker")
  zoneAdmissions          TechnicianServiceArea[]   @relation("TechnicianZoneSubject")
  approvedZoneAdmissions  TechnicianServiceArea[]   @relation("TechnicianZoneApprover")
  revokedZoneAdmissions   TechnicianServiceArea[]   @relation("TechnicianZoneRevoker")
  geographyReceipts       GeographyCommandReceipt[] @relation("GeographyReceiptActor")
  reviewedReferenceEntryVersions  ReferenceEntryVersion[] @relation("ReferenceEntryVersionReviewer")
  reviewedContentBlockRevisions   ContentBlockRevision[]  @relation("ContentBlockRevisionReviewer")
  reviewedLegalDocumentVersions   LegalDocumentVersion[]  @relation("LegalDocumentVersionReviewer")
  fileUploadIntents               FileUploadIntent[]      @relation("FileUploadIntentStaff")

  @@map("staff")
  @@schema("foundation")
}

model StaffBootstrapMarker {
  id      Int    @id @db.SmallInt
  staffId String @unique(map: "staff_bootstrap_marker_staff_id_key") @map("staff_id") @db.Uuid
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("staff_bootstrap_marker")
  @@schema("foundation")
}

model StaffWebCredential {
  staffId      String @id @map("staff_id") @db.Uuid
  login        String @unique(map: "staff_web_credentials_login_key") @db.VarChar(255)
  passwordHash String @map("password_hash") @db.VarChar(255)
  staff        Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("staff_web_credentials")
  @@schema("foundation")
}

model Permission {
  code        String           @id @db.VarChar(64)
  module      String           @db.VarChar(32)
  description String           @db.VarChar(500)
  protected   Boolean          @default(false)
  active      Boolean          @default(true)
  grants      RolePermission[]
  bootstrapGrants GeographyBootstrapPermission[]

  @@map("permissions")
  @@schema("foundation")
}

model Role {
  id          String                @id @db.Uuid
  code        String                @unique(map: "roles_code_key") @db.VarChar(64)
  name        String                @db.VarChar(80)
  description String                @default("") @db.VarChar(500)
  roleType    String                @default("CUSTOM") @map("role_type") @db.VarChar(16)
  status      String                @default("ACTIVE") @db.VarChar(16)
  version     Int                   @default(1)
  createdBy   String?               @map("created_by") @db.Uuid
  updatedBy   String?               @map("updated_by") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  creator     Staff?                @relation("RoleCreatedBy", fields: [createdBy], references: [id], onUpdate: Restrict, onDelete: Restrict)
  editor      Staff?                @relation("RoleUpdatedBy", fields: [updatedBy], references: [id], onUpdate: Restrict, onDelete: Restrict)
  grants      RolePermission[]
  assignments StaffRoleAssignment[]

  @@map("roles")
  @@schema("foundation")
}

model RolePermission {
  roleId         String     @map("role_id") @db.Uuid
  permissionCode String     @map("permission_code") @db.VarChar(64)
  scopeType      String     @map("scope_type") @db.VarChar(16)
  enabled        Boolean    @default(true)
  role           Role       @relation(fields: [roleId], references: [id], onUpdate: Restrict, onDelete: Restrict)
  permission     Permission @relation(fields: [permissionCode], references: [code], onUpdate: Restrict, onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
  @@schema("foundation")
}

// Partial unique active-staff index and deferred exactly-one-current check live in migration SQL.
model StaffRoleAssignment {
  id         String    @id @db.Uuid
  staffId    String    @map("staff_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  assignedBy String?   @map("assigned_by") @db.Uuid
  revokedBy  String?   @map("revoked_by") @db.Uuid
  assignedAt DateTime  @default(dbgenerated("statement_timestamp()")) @map("assigned_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  staff      Staff     @relation("RoleSubject", fields: [staffId], references: [id], onUpdate: Restrict, onDelete: Restrict)
  role       Role      @relation(fields: [roleId], references: [id], onUpdate: Restrict, onDelete: Restrict)
  assigner   Staff?    @relation("RoleAssignedBy", fields: [assignedBy], references: [id], onUpdate: Restrict, onDelete: Restrict)
  revoker    Staff?    @relation("RoleRevokedBy", fields: [revokedBy], references: [id], onUpdate: Restrict, onDelete: Restrict)
  bootstrapGrants GeographyBootstrapPermission[]

  @@index([roleId, staffId], map: "staff_role_assignments_role_staff_idx")
  @@map("staff_role_assignments")
  @@schema("foundation")
}

// P02 immutable legacy history; runtime cannot read it or issue individual grants.
model UserPermission {
  id             String    @id @db.Uuid
  staffId        String    @map("staff_id") @db.Uuid
  capability     String    @db.VarChar(64)
  scope          String    @db.VarChar(16)
  validFrom      DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil     DateTime? @map("valid_until") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  grantedBy      String?   @map("granted_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  staff          Staff     @relation(fields: [staffId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantedByStaff Staff?    @relation("UserPermissionGrantedBy", fields: [grantedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([staffId], map: "user_permissions_staff_id_idx")
  @@map("user_permissions")
  @@schema("foundation")
}

// Staff ↔ Telegram identity link; the verified binding flow lives outside P02-05
// (INSERT is not granted to the runtime role). Like user_permissions, the partial
// unique indexes (one active link per telegram subject and per staff member,
// WHERE revoked_at IS NULL) and the CHECK constraints exist only in migration SQL.
model StaffTelegramLink {
  id             String    @id @db.Uuid
  staffId        String    @map("staff_id") @db.Uuid
  telegramUserId BigInt    @map("telegram_user_id")
  username       String?   @db.VarChar(64)
  linkedBy       String?   @map("linked_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  staff          Staff     @relation(fields: [staffId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  linkedByStaff  Staff?    @relation("StaffTelegramLinkLinkedBy", fields: [linkedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessions       WebSession[]

  @@index([staffId], map: "staff_telegram_links_staff_id_idx")
  @@map("staff_telegram_links")
  @@schema("foundation")
}

model WebSession {
  id                  String    @id @db.Uuid
  staffId             String    @map("staff_id") @db.Uuid
  tokenHash           String    @unique(map: "web_sessions_token_hash_key") @map("token_hash") @db.VarChar(64)
  authVersion         Int       @map("auth_version")
  channel             String    @default("CRM") @db.VarChar(16)
  initdataDigest      String?   @map("initdata_digest") @db.VarChar(64)
  initdataExchangedAt DateTime? @map("initdata_exchanged_at") @db.Timestamptz(6)
  telegramLink        StaffTelegramLink? @relation(fields: [telegramLinkId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  telegramLinkId      String?   @map("telegram_link_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  idleExpiresAt       DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt   DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  staff               Staff     @relation(fields: [staffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([staffId], map: "web_sessions_staff_id_idx")
  @@index([absoluteExpiresAt], map: "web_sessions_absolute_expiry_idx")
  @@map("web_sessions")
  @@schema("foundation")
}

model WebAuthThrottle {
  keyHash  String           @id @map("key_hash") @db.VarChar(64)
  attempts WebAuthAttempt[]

  @@map("web_auth_throttles")
  @@schema("foundation")
}

model WebAuthAttempt {
  id          String          @id @db.Uuid
  keyHash     String          @map("key_hash") @db.VarChar(64)
  reservedAt  DateTime        @map("reserved_at") @db.Timestamptz(6)
  expiresAt   DateTime        @map("expires_at") @db.Timestamptz(6)
  failedAt    DateTime?       @map("failed_at") @db.Timestamptz(6)
  completedAt DateTime?       @map("completed_at") @db.Timestamptz(6)
  throttle    WebAuthThrottle @relation(fields: [keyHash], references: [keyHash], onDelete: Restrict, onUpdate: Restrict)

  @@index([keyHash, expiresAt], map: "web_auth_attempts_key_expiry_idx")
  @@index([expiresAt], map: "web_auth_attempts_expiry_idx")
  @@map("web_auth_attempts")
  @@schema("foundation")
}

model OutboxEvent {
  id              String    @id @db.Uuid
  eventId         String    @unique(map: "outbox_events_event_id_key") @map("event_id") @db.Uuid
  eventType       String    @map("event_type") @db.VarChar(64)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  status          String    @default("PENDING") @db.VarChar(16)
  payload         Json      @default("{}") @db.JsonB
  attemptCount    Int       @default(0) @map("attempt_count")
  leaseOwner      String?   @map("lease_owner") @db.Uuid
  leaseGeneration BigInt    @default(0) @map("lease_generation")
  leaseExpiresAt  DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  nextAttemptAt   DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastErrorCode   String?   @map("last_error_code") @db.VarChar(32)

  @@index([status, createdAt], map: "outbox_events_queue_idx")
  @@index([status, nextAttemptAt, createdAt, id], map: "outbox_events_due_idx")
  @@map("outbox_events")
  @@schema("foundation")
}

// P03-01 city foundation. Stable city identity (not a tenant); row_version is
// bumped by the city_guard_update trigger in migration SQL, never by the caller.
// The composite (id, current_version_id) FK to service_city_versions(city_id, id)
// forbids a foreign city's history; ACTIVE-requires-pointer, the lifecycle/code
// CHECKs, the timezone trigger and the immutability triggers live only in
// migration SQL. No "at most one ACTIVE city" rule exists here on purpose.
model ServiceCity {
  id               String                   @id @db.Uuid
  code             String                   @unique(map: "service_cities_code_key") @db.VarChar(32)
  lifecycle        String                   @default("DRAFT") @db.VarChar(16)
  rowVersion       Int                      @default(1) @map("row_version")
  currentVersionId String?                  @map("current_version_id") @db.Uuid
  currentVersion   ServiceCityVersion?      @relation("ServiceCityCurrentVersion", fields: [id, currentVersionId], references: [cityId, id], onDelete: Restrict, onUpdate: Restrict)
  versions         ServiceCityVersion[]     @relation("ServiceCityVersions")
  settingsVersions BusinessSettingsVersion[]
  districts        AdministrativeDistrict[]
  serviceAreas     ServiceArea[]
  adminAssignments StaffAdminCityAssignment[]
  cityMemberships  TechnicianCityMembership[]
  referenceEntries ReferenceEntry[]
  referenceEntryVersions ReferenceEntryVersion[] @relation("ReferenceEntryVersionCity")
  contentBlocks    ContentBlock[] @relation("ContentBlockCity")
  requestSessions  RequestSession[] @relation("RequestSessionCity")

  @@map("service_cities")
  @@schema("foundation")
}

// Immutable reviewed snapshot of one city's local settings: display name, IANA
// timezone, public contact and office hours. Every row is published; UPDATE,
// DELETE and TRUNCATE are refused by migration SQL triggers, so a correction is a
// new (city_id, version) row. office_hours is exactly seven ISO weekday arrays
// Mon..Sun of [startMinute, endMinute] pairs; [] is an explicitly closed day.
model ServiceCityVersion {
  id             String   @id @db.Uuid
  cityId         String   @map("city_id") @db.Uuid
  version        Int
  displayName    String   @map("display_name")
  addressDisplay String?  @map("address_display")
  timezone       String
  publicContact  String   @map("public_contact")
  officeHours    Json     @map("office_hours") @db.JsonB
  reviewedBy     String   @map("reviewed_by") @db.Uuid
  publishedAt    DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  city           ServiceCity @relation("ServiceCityVersions", fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewer       Staff    @relation("CityVersionReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentFor     ServiceCity[] @relation("ServiceCityCurrentVersion")
  referenceEntryVersions ReferenceEntryVersion[] @relation("ReferenceEntryVersionCityVersion")
  requestSessions RequestSession[] @relation("RequestSessionCityVersion")

  @@unique([cityId, version], map: "service_city_versions_city_version_key")
  @@unique([cityId, id], map: "service_city_versions_city_id_key")
  @@map("service_city_versions")
  @@schema("foundation")
}

// Published company settings revision. Deliberately has no city timezone/contact/
// office-hours columns: those live only in service_city_versions, so there is no
// second editable copy. MULTI_CITY is reserved vocabulary only - the resolver
// enables SINGLE_CITY and treats MULTI_CITY as unsupported configuration. No DRAFT
// state and no seeded row: the current revision is max(version). Immutability
// triggers live in migration SQL.
//
// P03-03 adds company-wide provenance as NULLable text: NULL means "unknown", never an
// approved legal/security/upload/retention value. Non-blank and bounded-length rules
// (business_settings_versions_*_check) live only in migration SQL. A policy ref is
// reviewed provenance, not the policy implementation itself. Existing revisions are
// preserved as-is and therefore keep meaning "unknown" for these columns.
model BusinessSettingsVersion {
  id                       String   @id @db.Uuid
  version                  Int
  launchMode               String   @map("launch_mode") @db.VarChar(16)
  primaryCityId            String   @map("primary_city_id") @db.Uuid
  reviewedBy               String   @map("reviewed_by") @db.Uuid
  publishedAt              DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  operatorName             String?  @map("operator_name")
  operatorRegistrationId   String?  @map("operator_registration_id")
  operatorAddress          String?  @map("operator_address")
  legalReviewRef           String?  @map("legal_review_ref")
  securityPolicyRef        String?  @map("security_policy_ref")
  retentionPolicyRef       String?  @map("retention_policy_ref")
  uploadPolicyRef          String?  @map("upload_policy_ref")
  primaryCity   ServiceCity @relation(fields: [primaryCityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewer      Staff    @relation("BusinessSettingsReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([version], map: "business_settings_versions_version_key")
  @@map("business_settings_versions")
  @@schema("foundation")
}

// P03-02 geography: real administrative district of one city. Optional reference
// data (a city may have none) that is archived, never deleted, because request
// snapshots keep the district label they were reviewed with. row_version is owned
// by the administrative_districts_guard_update trigger in migration SQL, and
// id/city/code are stable there. No seed, no runtime privilege.
model AdministrativeDistrict {
  id        String    @id @db.Uuid
  cityId    String    @map("city_id") @db.Uuid
  code      String    @db.VarChar(32)
  name      String
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  rowVersion Int      @default(1) @map("row_version")
  city      ServiceCity @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  coverage  ServiceAreaDistrictCoverage[]

  @@unique([cityId, code], map: "administrative_districts_city_code_key")
  @@unique([cityId, id], map: "administrative_districts_city_id_key")
  @@map("administrative_districts")
  @@schema("foundation")
}

// Stable service area identity inside one city: a company trip zone, not a
// district and not a tenant. current_version_id may only name a published revision
// of the same city and area; the composite (id, city_id, current_version_id) FK and
// the published-pointer trigger live in migration SQL, which also owns row_version.
model ServiceArea {
  id               String    @id @db.Uuid
  cityId           String    @map("city_id") @db.Uuid
  code             String    @db.VarChar(32)
  currentVersionId String?   @map("current_version_id") @db.Uuid
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)
  rowVersion       Int       @default(1) @map("row_version")
  city             ServiceCity @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentVersion   ServiceAreaVersion? @relation("ServiceAreaCurrentVersion", fields: [id, cityId, currentVersionId], references: [areaId, cityId, id], onDelete: Restrict, onUpdate: Restrict)
  versions         ServiceAreaVersion[] @relation("ServiceAreaVersions")
  zoneAdmissions   TechnicianServiceArea[]

  @@unique([cityId, code], map: "service_areas_city_code_key")
  @@unique([cityId, id], map: "service_areas_city_id_key")
  @@map("service_areas")
  @@schema("foundation")
}

// Revision of one service area. Created as a draft (published_at/published_by
// NULL); a draft is editable and its district coverage is editable, then one UPDATE
// publishes it without changing the reviewed content. Published revisions and their
// coverage are append-only (UPDATE/DELETE/TRUNCATE refused in migration SQL), so
// changing the zone is a new revision and old history keeps explaining itself.
model ServiceAreaVersion {
  id                  String    @id @db.Uuid
  cityId              String    @map("city_id") @db.Uuid
  areaId              String    @map("area_id") @db.Uuid
  version             Int
  name                String
  coverageDescription String?   @map("coverage_description")
  addressCriteria     String?   @map("address_criteria")
  createdBy           String    @map("created_by") @db.Uuid
  publishedAt         DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy         String?   @map("published_by") @db.Uuid
  rowVersion          Int       @default(1) @map("row_version")
  area                ServiceArea @relation("ServiceAreaVersions", fields: [cityId, areaId], references: [cityId, id], onDelete: Restrict, onUpdate: Restrict)
  creator             Staff     @relation("ServiceAreaVersionCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publisher           Staff?    @relation("ServiceAreaVersionPublisher", fields: [publishedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentFor          ServiceArea[] @relation("ServiceAreaCurrentVersion")
  coverage            ServiceAreaDistrictCoverage[]

  @@unique([cityId, areaId, version], map: "service_area_versions_city_area_version_key")
  @@unique([cityId, id], map: "service_area_versions_city_id_key")
  @@unique([areaId, cityId, id], map: "service_area_versions_area_city_id_key")
  @@map("service_area_versions")
  @@schema("foundation")
}

// Manual M:N coverage of one area revision by real districts of the same city. Both
// composite FKs are city-scoped, so a foreign district or a foreign revision cannot
// be mapped. FULL/PARTIAL is an advisory candidate only: neither value qualifies a
// concrete address, and no address is stored or derived here. Editable only while
// the parent revision is a draft; the child-change trigger locks the parent row and
// bumps its draft row_version, which serializes coverage edits against publication.
model ServiceAreaDistrictCoverage {
  cityId        String  @map("city_id") @db.Uuid
  areaVersionId String  @map("area_version_id") @db.Uuid
  districtId    String  @map("district_id") @db.Uuid
  relation      String  @db.VarChar(16)
  description   String?
  areaVersion   ServiceAreaVersion @relation(fields: [cityId, areaVersionId], references: [cityId, id], onDelete: Restrict, onUpdate: Restrict)
  district      AdministrativeDistrict @relation(fields: [cityId, districtId], references: [cityId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([areaVersionId, districtId])
  @@index([cityId, districtId], map: "service_area_district_coverage_district_idx")
  @@map("service_area_district_coverage")
  @@schema("foundation")
}

// P03-02 geography access (012). One row per permission code issued to one bootstrap
// assignment. This is NOT a role grant: the authorization layer resolves it only for
// the caller's current assignment, so a reassignment, a revocation or a replay cannot
// resurrect it. The founder binding is re-proved by geography_bootstrap_guard on every
// INSERT, INSERT is owner-only (runtime cannot insert), and revoked_at is the only
// mutable column and only null -> value; DELETE is refused. SQL-only guards.
model GeographyBootstrapPermission {
  assignmentId   String    @map("assignment_id") @db.Uuid
  permissionCode String    @map("permission_code") @db.VarChar(64)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  assignment     StaffRoleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@id([assignmentId, permissionCode])
  @@map("geography_bootstrap_permissions")
  @@schema("foundation")
}

// Administrative city assignment: a territory boundary for an operation, never a role
// grant and never technician work eligibility. One live row per staff+city pair (partial
// unique index is SQL-only); history stays as revoked rows and DELETE is refused by
// geography_admin_assignment_guard. granted_at is database-stamped; the guard requires
// an active web staff member with a current role and an active actor other than the
// subject. Revocation is the only UPDATE.
model StaffAdminCityAssignment {
  id        String    @id @db.Uuid
  staffId   String    @map("staff_id") @db.Uuid
  cityId    String    @map("city_id") @db.Uuid
  grantedBy String    @map("granted_by") @db.Uuid
  grantedAt DateTime  @default(dbgenerated("statement_timestamp()")) @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy String?   @map("revoked_by") @db.Uuid
  staff     Staff     @relation("AdminCityAssignmentSubject", fields: [staffId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  city      ServiceCity @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantor   Staff     @relation("AdminCityAssignmentGrantor", fields: [grantedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revoker   Staff?    @relation("AdminCityAssignmentRevoker", fields: [revokedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("staff_admin_city_assignments")
  @@schema("foundation")
}

// Dated technician work eligibility in one city. At most one live row per
// technician+city pair (partial unique index is SQL-only and is also the overlap
// guard). The period is immutable: a different period is a new row, revocation is an
// UPDATE of revoked_at/revoked_by only. The composite (technician_id, city_id, id)
// unique index is the same-city target for zone admissions.
model TechnicianCityMembership {
  id           String    @id @db.Uuid
  technicianId String    @map("technician_id") @db.Uuid
  cityId       String    @map("city_id") @db.Uuid
  validFrom    DateTime  @map("valid_from") @db.Timestamptz(6)
  validTo      DateTime? @map("valid_to") @db.Timestamptz(6)
  approvedBy   String    @map("approved_by") @db.Uuid
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy    String?   @map("revoked_by") @db.Uuid
  technician   Staff     @relation("TechnicianCityMembershipSubject", fields: [technicianId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  city         ServiceCity @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approver     Staff     @relation("TechnicianCityMembershipApprover", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revoker      Staff?    @relation("TechnicianCityMembershipRevoker", fields: [revokedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  zoneAdmissions TechnicianServiceArea[]

  @@unique([technicianId, cityId, id], map: "technician_city_memberships_identity_key")
  @@index([technicianId, cityId], map: "technician_city_memberships_technician_city_idx")
  @@map("technician_city_memberships")
  @@schema("foundation")
}

// Dated technician eligibility for one area of the same city. Both parent links are
// composite and city-scoped, so a foreign area or a foreign city admission cannot be
// used. geography_zone_guard additionally requires the whole admission period to sit
// inside its city membership period and refuses a revoked membership; the deferred
// geography_membership_zone_consistency trigger refuses a committed state where an
// active zone admission outlives its revoked city membership. Period is immutable,
// revocation is the only UPDATE, DELETE is refused.
model TechnicianServiceArea {
  id            String    @id @db.Uuid
  technicianId  String    @map("technician_id") @db.Uuid
  cityId        String    @map("city_id") @db.Uuid
  serviceAreaId String    @map("service_area_id") @db.Uuid
  membershipId  String    @map("membership_id") @db.Uuid
  validFrom     DateTime  @map("valid_from") @db.Timestamptz(6)
  validTo       DateTime? @map("valid_to") @db.Timestamptz(6)
  approvedBy    String    @map("approved_by") @db.Uuid
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy     String?   @map("revoked_by") @db.Uuid
  technician    Staff     @relation("TechnicianZoneSubject", fields: [technicianId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  serviceArea   ServiceArea @relation(fields: [cityId, serviceAreaId], references: [cityId, id], onDelete: Restrict, onUpdate: Restrict, map: "technician_service_areas_city_id_service_area_id_fkey")
  // PostgreSQL truncates identifiers to 63 bytes, so the 012 name
  // technician_service_areas_technician_id_city_id_membership_id_fkey is stored as the
  // 63-byte form below; Prisma must map that exact catalog name or drift never converges.
  membership    TechnicianCityMembership @relation(fields: [technicianId, cityId, membershipId], references: [technicianId, cityId, id], onDelete: Restrict, onUpdate: Restrict, map: "technician_service_areas_technician_id_city_id_membership_id_fk")
  approver      Staff     @relation("TechnicianZoneApprover", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revoker       Staff?    @relation("TechnicianZoneRevoker", fields: [revokedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([technicianId, serviceAreaId], map: "technician_service_areas_technician_area_idx")
  @@map("technician_service_areas")
  @@schema("foundation")
}

// Idempotency evidence for a geography command: actor, operation name, Idempotency-Key,
// SHA-256 of the canonical request and the created entity id/version. Deliberately no
// request body, no free text and no personal data. Append-only: UPDATE/DELETE/TRUNCATE
// are refused by geography_receipts_immutable in migration SQL.
model GeographyCommandReceipt {
  actorId       String   @map("actor_id") @db.Uuid
  operation     String   @db.VarChar(64)
  key           String   @db.Uuid
  bodyHash      String   @map("body_hash") @db.Char(64)
  entityId      String   @map("entity_id") @db.Uuid
  entityVersion Int      @map("entity_version")
  actor         Staff    @relation("GeographyReceiptActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([actorId, operation, key])
  @@map("geography_command_receipts")
  @@schema("foundation")
}

// P03-03 typed reference data (013). Stable identity, immutable reviewed versions and a
// current pointer. CALLBACK_INTERVAL is strictly CITY scoped; PAYMENT_METHOD,
// CANCEL_REASON, DECLINE_REASON and REQUEST_SOURCE are strictly COMPANY scoped. The
// scope/city pairing CHECK, the partial unique code indexes (company: type+code, city:
// city+type+code), the stable-identity/row_version guard and the append-only triggers
// live only in migration SQL. Archived rows stay as history and are never deleted.
model ReferenceEntry {
  id               String                  @id @db.Uuid
  type             String                  @db.VarChar(32)
  scope            String                  @db.VarChar(16)
  cityId           String?                 @map("city_id") @db.Uuid
  code             String                  @db.VarChar(64)
  rowVersion       Int                     @default(1) @map("row_version")
  currentVersionId String?                 @map("current_version_id") @db.Uuid
  archivedAt       DateTime?               @map("archived_at") @db.Timestamptz(6)
  city             ServiceCity?            @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentVersion   ReferenceEntryVersion?  @relation("ReferenceEntryCurrentVersion", fields: [id, type, currentVersionId], references: [entryId, type, id], onDelete: Restrict, onUpdate: Restrict)
  versions         ReferenceEntryVersion[] @relation("ReferenceEntryVersions")

  @@unique([type, id], map: "reference_entries_type_id_key")
  @@map("reference_entries")
  @@schema("foundation")
}

// Immutable reviewed revision of one reference entry. city_id, city_version_id and the
// callback minute window exist only for CALLBACK_INTERVAL (0 <= start < end <= 1440);
// every other type keeps all four NULL. city_version_id is creation provenance only: the
// timezone used by a consumer comes from an explicitly passed trusted intake/visit city
// version of the same city. No DRAFT state: every row is a published revision.
model ReferenceEntryVersion {
  id             String         @id @db.Uuid
  entryId        String         @map("entry_id") @db.Uuid
  type           String         @db.VarChar(32)
  cityId         String?        @map("city_id") @db.Uuid
  version        Int
  label          String
  validFrom      DateTime       @map("valid_from") @db.Timestamptz(6)
  validUntil     DateTime?      @map("valid_until") @db.Timestamptz(6)
  sourceRef      String         @map("source_ref")
  reviewedBy     String         @map("reviewed_by") @db.Uuid
  publishedAt    DateTime       @default(now()) @map("published_at") @db.Timestamptz(6)
  cityVersionId  String?        @map("city_version_id") @db.Uuid
  startMinute    Int?           @map("start_minute")
  endMinute      Int?           @map("end_minute")
  entry          ReferenceEntry @relation("ReferenceEntryVersions", fields: [type, entryId], references: [type, id], onDelete: Restrict, onUpdate: Restrict)
  city           ServiceCity?   @relation("ReferenceEntryVersionCity", fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cityVersion    ServiceCityVersion? @relation("ReferenceEntryVersionCityVersion", fields: [cityId, cityVersionId], references: [cityId, id], onDelete: Restrict, onUpdate: Restrict)
  reviewer       Staff          @relation("ReferenceEntryVersionReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentFor     ReferenceEntry[] @relation("ReferenceEntryCurrentVersion")

  @@unique([entryId, version], map: "reference_entry_versions_entry_version_key")
  @@unique([entryId, type, id], map: "reference_entry_versions_entry_type_id_key")
  @@map("reference_entry_versions")
  @@schema("foundation")
}

// P03-03 content block (013): stable identity with explicit COMPANY/CITY scope, a
// current revision pointer and row_version owned by the database. A block never copies
// city contacts, hours or timezone. allow_company_fallback is meaningful only for a
// COMPANY block (it is the explicit permission to be used when a city has no block of
// the same code). The scope/city CHECK, the partial unique code indexes, the
// stable-identity/row_version guard and the append-only triggers live in migration SQL.
model ContentBlock {
  id                  String                 @id @db.Uuid
  code                String                 @db.VarChar(64)
  kind                String                 @db.VarChar(16)
  scope               String                 @db.VarChar(16)
  cityId              String?                @map("city_id") @db.Uuid
  allowCompanyFallback Boolean               @default(false) @map("allow_company_fallback")
  rowVersion          Int                    @default(1) @map("row_version")
  currentRevisionId   String?                @map("current_revision_id") @db.Uuid
  archivedAt          DateTime?              @map("archived_at") @db.Timestamptz(6)
  city                ServiceCity?           @relation("ContentBlockCity", fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentRevision     ContentBlockRevision?  @relation("ContentBlockCurrentRevision", fields: [id, currentRevisionId], references: [blockId, id], onDelete: Restrict, onUpdate: Restrict)
  revisions           ContentBlockRevision[] @relation("ContentBlockRevisions")

  @@map("content_blocks")
  @@schema("foundation")
}

// Immutable reviewed revision of one content block: title/body/source are the reviewed
// snapshot, so a published correction is always a new revision row.
model ContentBlockRevision {
  id          String       @id @db.Uuid
  blockId     String       @map("block_id") @db.Uuid
  version     Int
  title       String
  body        String
  sourceRef   String       @map("source_ref")
  reviewedBy  String       @map("reviewed_by") @db.Uuid
  publishedAt DateTime     @default(now()) @map("published_at") @db.Timestamptz(6)
  block       ContentBlock @relation("ContentBlockRevisions", fields: [blockId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewer    Staff        @relation("ContentBlockRevisionReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentFor  ContentBlock[] @relation("ContentBlockCurrentRevision")

  @@unique([blockId, version], map: "content_block_revisions_block_version_key")
  @@unique([blockId, id], map: "content_block_revisions_block_id_key")
  @@map("content_block_revisions")
  @@schema("foundation")
}

// P03-03 legal document identity (013): one stable document per (purpose, kind). purpose
// is one of REQUEST_PROCESSING / ADDRESS_COVERAGE / MARKETING and kind separates the
// privacy POLICY, the CONSENT_FORM a GIVEN consent must reference, and an OPT_IN_NOTICE.
// row_version is bumped by the database guard; the current pointer is a CAS UPDATE.
model LegalDocument {
  id               String                 @id @db.Uuid
  purpose          String                 @db.VarChar(32)
  kind             String                 @db.VarChar(24)
  rowVersion       Int                    @default(1) @map("row_version")
  currentVersionId String?                @map("current_version_id") @db.Uuid
  currentVersion   LegalDocumentVersion?  @relation("LegalDocumentCurrentVersion", fields: [id, currentVersionId], references: [documentId, id], onDelete: Restrict, onUpdate: Restrict)
  versions         LegalDocumentVersion[] @relation("LegalDocumentVersions")

  @@unique([purpose, kind], map: "legal_documents_purpose_kind_key")
  @@unique([id, purpose, kind], map: "legal_documents_id_purpose_kind_key")
  @@map("legal_documents")
  @@schema("foundation")
}

// Immutable reviewed legal text. checksum is the SHA-256 of the exact UTF-8 body and is
// verified by the database CHECK with the built-in pg sha256()/convert_to()/encode()
// (no pgcrypto). purpose/kind are proven equal to the parent document by the composite
// FK, and are immutable. A GIVEN consent may only reference a current CONSENT_FORM
// version; a policy or notice document never accepts a consent event.
model LegalDocumentVersion {
  id           String            @id @db.Uuid
  documentId   String            @map("document_id") @db.Uuid
  purpose      String            @db.VarChar(32)
  kind         String            @db.VarChar(24)
  version      Int
  title        String
  body         String
  checksum     String            @db.VarChar(64)
  legalBasis   String            @map("legal_basis")
  sourceRef    String            @map("source_ref")
  reviewedBy   String            @map("reviewed_by") @db.Uuid
  publishedAt  DateTime          @default(now()) @map("published_at") @db.Timestamptz(6)
  document     LegalDocument     @relation("LegalDocumentVersions", fields: [documentId, purpose, kind], references: [id, purpose, kind], onDelete: Restrict, onUpdate: Restrict)
  reviewer     Staff             @relation("LegalDocumentVersionReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentFor   LegalDocument[]   @relation("LegalDocumentCurrentVersion")
  consents     ConsentRecord[]   @relation("ConsentDocumentVersion")

  @@unique([documentId, version], map: "legal_document_versions_document_version_key")
  @@unique([documentId, id], map: "legal_document_versions_document_id_key")
  @@unique([documentId, id, purpose], map: "legal_document_versions_document_id_purpose_key")
  @@map("legal_document_versions")
  @@schema("foundation")
}

// Minimal pre-submit anchor for consent evidence: a server-generated secret hash and the
// trusted intake city context only. Deliberately no name, phone, address, request or
// customer column. created_at is forced from the database clock by the guard trigger and
// expires_at is supplied by the trusted policy (no default TTL); both are immutable, and
// only one revoke (revoked_at NULL -> database clock) is allowed. This is not public
// authentication F; external session issuance is P05.
model RequestSession {
  id                  String    @id @db.Uuid
  secretHash          String    @unique(map: "request_sessions_secret_hash_key") @map("secret_hash") @db.VarChar(64)
  intakeCityId        String    @map("intake_city_id") @db.Uuid
  intakeCityVersionId String    @map("intake_city_version_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  intakeCity          ServiceCity @relation("RequestSessionCity", fields: [intakeCityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  intakeCityVersion   ServiceCityVersion @relation("RequestSessionCityVersion", fields: [intakeCityId, intakeCityVersionId], references: [cityId, id], onDelete: Restrict, onUpdate: Restrict)
  consents            ConsentRecord[]
  fileUploadIntents   FileUploadIntent[] @relation("FileUploadIntentSession")

  @@map("request_sessions")
  @@schema("foundation")
}

// Append-only consent evidence (013): one row per GIVEN/REVOKED event, never updated or
// deleted. GIVEN needs a live unexpired anchor and the current CONSENT_FORM version (a
// stale text is refused, not accepted silently); REVOKED must name the exact GIVEN event
// of the same session/purpose/document/version and one revoke per GIVEN is enforced by
// the unique supersedes index. occurred_at is forced from the database clock by the
// guard and the runtime has no INSERT privilege on it. evidence_ref is a non-PII
// reference; unique(session_id, evidence_ref) makes a replay detectable.
model ConsentRecord {
  id                String              @id @db.Uuid
  sessionId         String              @map("session_id") @db.Uuid
  documentId        String              @map("document_id") @db.Uuid
  documentVersionId String              @map("document_version_id") @db.Uuid
  purpose           String              @db.VarChar(32)
  action            String              @db.VarChar(16)
  legalBasis        String              @map("legal_basis")
  source            String              @default("FORM") @db.VarChar(32)
  evidenceRef       String              @map("evidence_ref") @db.Uuid
  occurredAt        DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(6)
  supersedesId      String?             @map("supersedes_id") @db.Uuid
  session           RequestSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  documentVersion   LegalDocumentVersion @relation("ConsentDocumentVersion", fields: [documentId, documentVersionId, purpose], references: [documentId, id, purpose], onDelete: Restrict, onUpdate: Restrict)
  supersedes        ConsentRecord?      @relation("ConsentSupersedes", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersededBy      ConsentRecord?      @relation("ConsentSupersedes")
  fileUploadIntents FileUploadIntent[]  @relation("FileUploadIntentConsent")

  @@unique([sessionId, evidenceRef], map: "consent_records_session_evidence_key")
  @@unique([supersedesId], map: "consent_records_supersedes_id_key")
  @@unique([id, sessionId, documentVersionId, purpose], map: "consent_records_intent_basis_key")
  @@map("consent_records")
  @@schema("foundation")
}

// P03-04 slice A reservation intent (014): an immutable snapshot of one owner, the
// exact consent basis it was granted under, the reviewed policy snapshot and the
// declared MIME/bytes, plus the single RESERVED -> CANCELLED transition. There is no
// object key, no file row and no READY state: this table reserves future capacity and
// nothing else. Exactly one owner is set (request session XOR staff; the staff variant
// has no runtime INSERT privilege until the P03-05 workflow with real authorization).
// created_at, state, cancelled_at and row_version are database-owned: the INSERT guard
// forces RESERVED/NULL/1 and the UPDATE guard stamps the cancel and OLD+1 row_version.
// The DB-owned row_version guard, the owner-XOR/consent-basis/state/size/allowlist
// CHECKs, the closed-MIME and expiry-vs-anchor rules, the quota check under
// session -> document locks and the delete/truncate refusal live only in migration SQL.
model FileUploadIntent {
  id                       String         @id @db.Uuid
  ownerRequestSessionId    String?        @map("owner_request_session_id") @db.Uuid
  ownerStaffId             String?        @map("owner_staff_id") @db.Uuid
  consentRecordId          String?        @map("consent_record_id") @db.Uuid
  consentDocumentVersionId String?        @map("consent_document_version_id") @db.Uuid
  consentPurpose           String?        @map("consent_purpose") @db.VarChar(32)
  policyVersionId          String         @map("policy_version_id") @db.Uuid
  policySourceRef          String         @map("policy_source_ref")
  policySha256             String         @map("policy_sha256") @db.VarChar(64)
  allowedMimeTypes         Json           @map("allowed_mime_types") @db.JsonB
  maxFileBytes             BigInt         @map("max_file_bytes")
  maxOwnerBytes            BigInt         @map("max_owner_bytes")
  maxOwnerFiles            Int            @map("max_owner_files")
  policyExpiresAt          DateTime       @map("policy_expires_at") @db.Timestamptz(6)
  declaredMime             String         @map("declared_mime") @db.VarChar(100)
  declaredBytes            BigInt         @map("declared_bytes")
  expiresAt                DateTime       @map("expires_at") @db.Timestamptz(6)
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  idempotencyKey           String         @map("idempotency_key") @db.Uuid
  bodySha256               String         @map("body_sha256") @db.VarChar(64)
  state                    String         @map("state") @db.VarChar(16)
  cancelledAt              DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  rowVersion               Int            @default(1) @map("row_version")
  ownerRequestSession      RequestSession? @relation("FileUploadIntentSession", fields: [ownerRequestSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownerStaff               Staff?          @relation("FileUploadIntentStaff", fields: [ownerStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // Composite basis FK: the evidence row must belong to this session, this document
  // version and this purpose. GIVEN/unrevoked/current is proven by the INSERT guard.
  // The explicit map keeps the reviewed 014 constraint name instead of Prisma's
  // truncated default, so `migrate diff` converges on the real catalog.
  consentRecord            ConsentRecord?  @relation("FileUploadIntentConsent", fields: [consentRecordId, ownerRequestSessionId, consentDocumentVersionId, consentPurpose], references: [id, sessionId, documentVersionId, purpose], onDelete: Restrict, onUpdate: Restrict, map: "file_upload_intents_consent_basis_fkey")

  // The two owner+idempotency unique indexes and the pending-quota index are PARTIAL
  // indexes (WHERE owner_... IS NOT NULL), which Prisma cannot express; they exist only
  // in migration SQL, exactly like the other partial unique indexes in this schema.
  @@map("file_upload_intents")
  @@schema("foundation")
}